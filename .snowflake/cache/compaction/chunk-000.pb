target/manifest.json��({"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/manifest/v12.json", "dbt_version": "1.9.4", "generated_at": "2026-10-28T19:43:58.265327Z", "invocation_id": "0edaf7ea-5b49-48b8-805b-0f4aeeadfb41", "env": {}, "project_name": "ctx_earned_hours_shadow", "project_id": "b21633e90505728ee7e1105368a99142", "user_id": null, "send_anonymous_usage_stats": false, "adapter_type": "snowflake"}, "nodes": {"model.ctx_earned_hours_shadow.dim_date": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "GOLD", "name": "dim_date", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "marts/dim_date.sql", "original_file_path": "models/marts/dim_date.sql", "unique_id": "model.ctx_earned_hours_shadow.dim_date", "fqn": ["ctx_earned_hours_shadow", "marts", "dim_date"], "alias": "dim_date", "checksum": {"name": "sha256", "checksum": "f11059362d1de5e3f13dcb809b33b1b0111591871cfc1536e4115180d44b9c9f"}, "config": {"enabled": true, "alias": null, "schema": "GOLD", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "dynamic_table", "incremental_strategy": null, "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "target_lag": "1 hour", "refresh_mode": "AUTO"}, "tags": [], "description": "Fiscal calendar, reused read-only from PRD_DW (SD-18).", "columns": {"date_key": {"name": "date_key", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/marts/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "GOLD", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "AUTO"}, "created_at": 1792704929.817075, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_date", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='AUTO'\n    )\n}}\n\n-- Gold: fiscal calendar, reused read-only from the DW (SD-18) -- not rebuilt.\n-- Matches production's own REF_DATE sourcing decision. Key = date_key itself:\n-- a date dimension's natural key is already stable and unique, so no hash surrogate\n-- is needed here (a deliberate, documented exception to hashing every key).\n-- Target lag matches the pipeline's 1-hour cadence (not daily, despite rarely changing)\n-- to stay compatible with downstream Dynamic Tables that join it (a Dynamic Table's lag\n-- can't be tighter than its upstream's).\n\nselect\n    onlydate                as calendar_date,\n    dateyyyymmdd             as date_key,\n\n    calendaryear             as calendar_year,\n    calendarmonth            as calendar_month,\n    calendarmonthname        as calendar_month_name,\n    calendardayofweekname    as day_of_week_name,\n\n    fiscalyear               as fiscal_year,\n    fiscalmonth              as fiscal_month,\n    fiscalperiod             as fiscal_period,\n    fiscalmonthdisplay       as fiscal_month_display,\n    fiscalmonthdisplaysort   as fiscal_month_display_sort,\n    fiscalweek               as fiscal_week,\n    fiscalweekdisplay        as fiscal_week_display,\n    fiscalquarteryear        as fiscal_quarter_year,\n    fiscalquarterdisplay     as fiscal_quarter_display,\n    fiscalstartofmonth       as fiscal_start_of_month,\n    fiscalendofmonth         as fiscal_end_of_month,\n    fiscalstartofyear        as fiscal_start_of_year,\n    fiscalendofyear          as fiscal_end_of_year,\n    isfiscalmonthend         as is_fiscal_month_end\n\nfrom {{ source('prd_dw', 'V_CRETEX_CALENDAR_DATE_DIM') }}", "language": "sql", "refs": [], "sources": [["prd_dw", "V_CRETEX_CALENDAR_DATE_DIM"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.prd_dw.V_CRETEX_CALENDAR_DATE_DIM"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/marts/dim_date.sql", "compiled": true, "compiled_code": "\n\n-- Gold: fiscal calendar, reused read-only from the DW (SD-18) -- not rebuilt.\n-- Matches production's own REF_DATE sourcing decision. Key = date_key itself:\n-- a date dimension's natural key is already stable and unique, so no hash surrogate\n-- is needed here (a deliberate, documented exception to hashing every key).\n-- Target lag matches the pipeline's 1-hour cadence (not daily, despite rarely changing)\n-- to stay compatible with downstream Dynamic Tables that join it (a Dynamic Table's lag\n-- can't be tighter than its upstream's).\n\nselect\n    onlydate                as calendar_date,\n    dateyyyymmdd             as date_key,\n\n    calendaryear             as calendar_year,\n    calendarmonth            as calendar_month,\n    calendarmonthname        as calendar_month_name,\n    calendardayofweekname    as day_of_week_name,\n\n    fiscalyear               as fiscal_year,\n    fiscalmonth              as fiscal_month,\n    fiscalperiod             as fiscal_period,\n    fiscalmonthdisplay       as fiscal_month_display,\n    fiscalmonthdisplaysort   as fiscal_month_display_sort,\n    fiscalweek               as fiscal_week,\n    fiscalweekdisplay        as fiscal_week_display,\n    fiscalquarteryear        as fiscal_quarter_year,\n    fiscalquarterdisplay     as fiscal_quarter_display,\n    fiscalstartofmonth       as fiscal_start_of_month,\n    fiscalendofmonth         as fiscal_end_of_month,\n    fiscalstartofyea