target/run_results.json��{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.9.4", "generated_at": "2026-10-28T19:44:11.681460Z", "invocation_id": "0edaf7ea-5b49-48b8-805b-0f4aeeadfb41", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:00.230097Z", "completed_at": "2026-10-28T19:44:00.255916Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:00.305838Z", "completed_at": "2026-10-28T19:44:01.228117Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.0203917026519775, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c809e0-0109-6965-0002-921610ede076"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic company enrollment gate, reused directly, not rebuilt (SD-10).\n-- Never hardcode a Kinetic company list anywhere downstream -- join to this model.\n\nselect\n    company       as company_code,\n    isactive      as is_active_raw,\n    fiscalyear_start,\n    fiscalperiod_start,\n    fiscalyear_end,\n    fiscalperiod_end\nfrom MATILLION_RAW.CRETEX_EPICOR_KINETIC.CTXEPICORKINETIC_V_ANALYTICS_COMPANY_ENROLLMENT\nwhere isactive = 'Y'", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:00.223291Z", "completed_at": "2026-10-28T19:44:00.237942Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:00.272042Z", "completed_at": "2026-10-28T19:44:01.576985Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.3698844909667969, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.dim_part", "compiled": true, "compiled_code": "\n\n-- Gold: conformed part dimension, reused read-only from the DW (SD-18) -- not rebuilt.\n-- Matches production's own REF_PART_DIM sourcing decision. Filtered to our 3 Kinetic\n-- companies only (ProfitKey's '14'/'32' excluded -- out of scope per SD-01).\n-- Key = part_dim_key, already provided by the DW (company + part + revision, resolved).\n\nselect\n    companyid_part_rev_source_parthk_key   as part_dim_key,\n    company_id,\n    part_number                            as part_key,\n    revision_number                        as part_revision,\n    part_source,\n    internal_part_number,\n    external_part_number,\n    part_desc,\n    part_desc_2,\n    revshortdesc                           as rev_short_desc,\n    revdescription                         as rev_description,\n    prod_code                              as product_code,\n    type_code,\n    part_class_desc,\n    commercial_category,\n    commercial_sub_category,\n    approved,\n    approved_date,\n    effective_date,\n    part_uses_inventory,\n    part_deleted_date,\n    part_deleted_flag,\n    part_rev_deleted_date,\n    part_rev_deleted_flag,\n    part_intro_date,\n    part_age_years,\n    part_age_months\nfrom PRD_DW.DATAMART.T_DIMPART_ALLERPS\nwhere company_id in ('CTX11002', 'CTX11003', 'CTX11101')", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:00.210359Z", "completed_at": "2026-10-28T19:44:00.237050Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:00.238636Z", "completed_at": "2026-10-28T19:44:01.596335Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.3899877071380615, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_date", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_date", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.dim_date", "compiled": true, "compiled_code": "\n\n-- Gold: fiscal calendar, reused read-only from the DW (SD-18) -- not rebuilt.\n-- Matches production's own REF_DATE sourcing decision. Key = date_key itself:\n-- a date dimension's natural key is already stable and unique, so no hash surrogate\n-- is needed here (a deliberate, documented exception to hashing every key).\n-- Target lag matches the pipeline's 1-hour cadence (not daily, despite rarely changing)\n-- to stay compatible with downstream Dynamic Tables that join it (a Dynamic Table's lag\n-- can't be tighter than its upstream's).\n\nselect\n    onlydate                as calendar_date,\n    dateyyyymmdd             as date_key,\n\n    calendaryear             as calendar_year,\n    calendarmonth            as calendar_month,\n    calendarmonthname        as calendar_month_name,\n    calendardayofweekname    as day_of_week_name,\n\n    fiscalyear               as fiscal_year,\n    fiscalmonth              as fiscal_month,\n    fiscalperiod             as fiscal_period,\n    fiscalmonthdisplay       as fiscal_month_display,\n    fiscalmonthdisplaysort   as fiscal_month_display_sort,\n    fiscalweek               as fiscal_week,\n    fiscalweekdisplay        as fiscal_week_display,\n    fiscalquarteryear        as fiscal_quarter_year,\n    fiscalquarterdisplay     as fiscal_quarter_display,\n    fiscalstartofmonth       as fiscal_start_of_month,\n    fiscalendofmonth         as fiscal_end_of_month,\n    fiscalstartofyear        as fiscal_start_of_year,\n    fiscalendofyear          as fiscal_end_of_year,\n    isfiscalmonthend         as is_fiscal_month_end\n\nfrom PRD_DW.DATAMART.V_CRETEX_CALENDAR_DATE_DIM", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_date", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:01.247430Z", "completed_at": "2026-10-28T19:44:01.283910Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:01.287626Z", "completed_at": "2026-10-28T19:44:04.778635Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 3.5380101203918457, "adapter_response": {"_message": "SUCCESS 59", "code": "SUCCESS", "rows_affected": 59, "query_id": "01c809e0-0109-6965-0002-921610ede15e"}, "message": "SUCCESS 59", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__department", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job-costing department master. Thin rename only.\n-- Gated by the enrollment view (SD-10).\n--\n-- SD-22: jc_dept is normalized with upper(trim()) defensively, for join consistency\n-- with the other models' jc_dept -- confirmed 0 case variance in this table itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jcdept))     as jc_dept,\n        description             as department_description,\n        globaljcdept            as is_global_jc_dept,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JCDEPT\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__department", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:01.256338Z", "completed_at": "2026-10-28T19:44:01.285030Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:01.325709Z", "completed_at": "2026-10-28T19:44:04.810664Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 3.569270610809326, "adapter_response": {"_message": "SUCCESS 1006", "code": "SUCCESS", "rows_affected": 1006, "query_id": "01c809e0-0109-6965-0002-921610ede15a"}, "message": "SUCCESS 1006", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__employee", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic employee master. Thin rename only. Gated by the enrollment view (SD-10).\n-- jc_dept (JCDEPT) is the job-costing department -- the reporting one. The separate\n-- DEPARTMENT column is free-text HR data and is deliberately not carried as the\n-- reporting department (same column trap production documents).\n--\n-- SD-22: emp_id is normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(empid))      as emp_id,\n        name                    as full_name,\n        firstname               as first_name,\n        lastname                as last_name,\n        upper(trim(jcdept))     as jc_dept,\n        shift                   as shift_num,\n        laborrate               as labor_rate,\n        empstatus               as employee_status,\n        productionworker        as is_production_worker,\n        enrollmentdate          as enrollment_date_text,\n        departuredate           as departure_date_text,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_EMPBASIC\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__employee", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:01.262964Z", "completed_at": "2026-10-28T19:44:01.286041Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:01.362470Z", "completed_at": "2026-10-28T19:44:05.326429Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 4.08428168296814, "adapter_response": {"_message": "SUCCESS 19333", "code": "SUCCESS", "rows_affected": 19333, "query_id": "01c809e0-0109-6965-0002-921610ede166"}, "message": "SUCCESS 19333", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_header", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job header. Thin rename only. Gated by the enrollment view (SD-10).\n-- planned_start_quantity_not_produced -- renamed from PRODQTY (production's own trap:\n-- this is the PLANNED quantity, not what was actually produced; do not mistake it for\n-- quantity_produced on labor_detail/job_operation).\n--\n-- SD-22: job_num, part_num, part_revision are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding. part_num /\n-- part_revision case variance is also a contributing cause of the part-match-rate gap\n-- (SD-21).\n\nwith source as (\n\n    select\n        company                             as company_code,\n        upper(trim(jobnum))                 as job_num,\n        upper(trim(partnum))                as part_num,\n        upper(trim(revisionnum))            as part_revision,\n        partdescription                     as part_description,\n        prodqty                             as planned_start_quantity_not_produced,\n        jobtype                             as job_type,\n        jobengineered                       as is_job_engineered,\n        jobcomplete                         as is_job_complete,\n        jobclosed                           as is_job_closed,\n        startdate                           as start_date_text,\n        duedate                             as due_date_text,\n        plant                               as plant,\n        (upper(trim(jobnum)) like 'MRP-%')  as is_mrp_planning_job,\n        sysrevid                            as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JOBHEAD\n\n)\n\n-- is_mrp_planning_job: MRP-suggested planning jobs carry large estimated hours against\n-- zero produced quantity. They do not affect earned hours (which is driven by quantity\n-- produced), but would badly pollute any budget/estimate-side rollup if not flagged --\n-- a real source-data fact, not a stylistic choice (confirmed against the production\n-- build's own documented investigation of this pattern).\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:04.784342Z", "completed_at": "2026-10-28T19:44:04.793641Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:04.794344Z", "completed_at": "2026-10-28T19:44:05.872728Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.0898828506469727, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_department", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_department", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.dim_department", "compiled": true, "compiled_code": "\n\n-- Gold: conformed department dimension, from Bronze. Built for completeness/future\n-- grains -- NOT joined into fct_labor below, since production's own\n-- EARNED_HOURS_JOB_OPERATION grain doesn't carry department either (verified via its\n-- column list: job/operation/part/resource, no department).\n\nselect\n    md5(concat_ws('|',coalesce(cast(company_code as varchar), '_surrogate_key_null_'),coalesce(cast(jc_dept as varchar), '_surrogate_key_null_'))) as department_key,\n    company_code,\n    jc_dept,\n    department_description,\n    is_global_jc_dept\nfrom SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__department", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_department", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:04.815745Z", "completed_at": "2026-10-28T19:44:04.822720Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:04.823330Z", "completed_at": "2026-10-28T19:44:06.036552Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.2221384048461914, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_employee", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_employee", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.dim_employee", "compiled": true, "compiled_code": "\n\n-- Gold: conformed employee dimension, from Bronze.\n\nselect\n    md5(concat_ws('|',coalesce(cast(company_code as varchar), '_surrogate_key_null_'),coalesce(cast(emp_id as varchar), '_surrogate_key_null_'))) as employee_key,\n    company_code,\n    emp_id,\n    full_name,\n    first_name,\n    last_name,\n    jc_dept,\n    shift_num,\n    labor_rate,\n    employee_status,\n    is_production_worker,\n    enrollment_date_text,\n    departure_date_text\nfrom SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__employee", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_employee", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:01.269859Z", "completed_at": "2026-10-28T19:44:01.286840Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:01.370462Z", "completed_at": "2026-10-28T19:44:07.249081Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 6.0061986446380615, "adapter_response": {"_message": "SUCCESS 216270", "code": "SUCCESS", "rows_affected": 216270, "query_id": "01c809e0-0109-6965-0002-921610ede162"}, "message": "SUCCESS 216270", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job operations -- the only place Kinetic standard hours live.\n-- Thin rename only. Gated by the enrollment view (SD-10). Carries BOTH candidate\n-- standards (est_production_hours = budget, NOT earned hours; production_standard_raw +\n-- standard_format = the per-unit rate Silver must convert and multiply by quantity\n-- produced -- SD-11). No conversion happens here; that is Silver's job.\n--\n-- SD-22: job_num and operation_code are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n--\n-- SD-26: setup_pct_complete added -- carries ERP_JOBOPER.SETUPPCTCOMPLETE, needed for the\n-- corrected Setup earned-hours formula (read from production's own documented business\n-- rules, not re-derived). See int_labor_standard_hours for the formula itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        subcontract             as is_subcontract,\n        runqty                  as run_quantity,\n        estsethours             as est_setup_hours,\n        estprodhours            as est_production_hours,\n        prodstandard            as production_standard_raw,\n        stdformat               as standard_format,\n        stdbasis                as standard_basis,\n        opsperpart              as ops_per_part,\n        qtyper                  as quantity_per,\n        qtypercycle             as quantity_per_cycle,\n        actprodhours            as act_production_hours,\n        actsetuphours           as act_setup_hours,\n        qtycompleted            as quantity_completed,\n        setuppctcomplete        as setup_pct_complete,\n        jobengineered           as is_job_engineered,\n        opcomplete              as is_operation_complete,\n        jobcomplete             as is_job_complete,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JOBOPER\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code\nwhere source.company_code <> '000000'  -- junk placeholder company, not a real enrolled company", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_operation", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:01.276558Z", "completed_at": "2026-10-28T19:44:01.304339Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:01.378552Z", "completed_at": "2026-10-28T19:44:08.260533Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 7.016893625259399, "adapter_response": {"_message": "SUCCESS 227594", "code": "SUCCESS", "rows_affected": 227594, "query_id": "01c809e0-0109-6965-0002-921610ede16a"}, "message": "SUCCESS 227594", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__labor_detail", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic labor detail -- the Kinetic fact source.\n-- Thin rename only, no business logic. Gated by the enrollment view (SD-10), not a\n-- hardcoded company list. Carries Epicor's native EARNEDHRS through as a plain column --\n-- NOT treated as authoritative earned hours (SD-11). The real derivation happens in\n-- int_labor_standard_hours (Silver), from the operation's per-unit standard x quantity\n-- produced. This column exists here only so Silver can cross-check against it later.\n--\n-- SD-22: job_num, employee_num, resource_group_key, operation_code are normalized with\n-- upper(trim()) -- the same real-world key is stored with inconsistent casing across rows\n-- in the raw source (confirmed empirically, e.g. 'BPQ45915' vs 'bpq45915'). Case-sensitive\n-- joins on these columns silently drop matched rows. See PROJECT_LOG.md SD-22/SD-23.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        laborhedseq             as labor_header_seqnum,\n        labordtlseq             as labor_detail_seqnum,\n        upper(trim(employeenum)) as employee_num,\n        labortype               as labor_type_code,\n        labortypepseudo         as labor_type_pseudo,\n        rework                  as is_rework,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        upper(trim(jcdept))      as jc_dept,\n        upper(trim(resourcegrpid)) as resource_group_key,\n        laborhrs                as actual_hours,\n        burdenhrs               as burden_hours,\n        laborqty                as quantity_produced,\n        scrapqty                as quantity_scrapped,\n        earnedhrs               as native_earned_hours_crosscheck,\n        complete                as is_complete,\n        opcomplete              as is_operation_complete,\n        clockindate             as clock_in_date_text,\n        payrolldate             as payroll_date_text,\n        fiscalyear              as fiscal_year,\n        fiscalperiod            as fiscal_period,\n        postedtogl              as is_posted_to_gl,\n        wipposted               as is_wip_posted,\n        laborrate               as labor_rate,\n        burdenrate              as burden_rate,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_LABORDTL\n\n)\n\n-- No is_incremental() filter: the source is a full flush-and-fill snapshot (SD-03), so\n-- every run re-presents the full filtered set and the merge's unique_key does the\n-- row-level insert/update. This does not handle source-side deletes -- acceptable for\n-- now, revisit if that becomes material.\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__labor_detail", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:07.254287Z", "completed_at": "2026-10-28T19:44:07.261613Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:07.262206Z", "completed_at": "2026-10-28T19:44:08.767153Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.5142343044281006, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.int_labor_standard_hours", "compiled": true, "compiled_code": "\n\n-- Silver/intermediate: per-unit Production rate and operation-level Setup credit for every\n-- Kinetic job operation.\n--\n-- SD-26 (REVISED FOUNDATION -- replaces SD-14/SD-19/SD-23/SD-24): the prior several\n-- iterations of this model (a 9-way STANDARD_FORMAT conversion from PRODSTANDARD; an\n-- operation-level QUANTITY_COMPLETED-driven earned_hours; a conditional zero-standard\n-- setup-credit rule) were all built by reverse-engineering empirically from reconciliation\n-- data, not from the actual documented business rule. Reading production's own Silver\n-- column comments directly (CTX_EARNED_HOURS_PRD.SILVER.FACT_LABOR) plus the Cretex\n-- Medallion PoC Earned Hours Business Design Document surfaced the real rule, which is\n-- simpler than anything previously built here:\n--\n--   Production-type labor (labortypepseudo='P', non-rework): earns\n--   quantity_produced * (est_production_hours / run_quantity) per transaction.\n--   Kinetic's standard rate is read directly from Epicor's own pre-computed\n--   est_production_hours, NOT re-derived from PRODSTANDARD/STANDARD_FORMAT -- Epicor\n--   already applied whatever internal format math applies when it computed that\n--   estimate, so re-deriving it from raw fields was duplicating (and, per the 87.67%\n--   agreement rate measured empirically, occasionally disagreeing with) work Epicor had\n--   already done correctly.\n--\n--   Setup-type labor (labortypepseudo='S', non-rework): earns a FIXED amount per\n--   OPERATION (never multiplied by quantity -- \"Setup is a FIXED amount per operation,\n--   so dividing it by pieces is a category error\", per production's own column\n--   documentation), credited ONCE regardless of how many Setup labor transactions exist\n--   on that operation. This mirrors a documented historical defect in the Cretex\n--   business-design process itself: multiple Setup time entries against the same\n--   operation were once double/multiply-counting the setup budget (job 200013 op 21,\n--   a 5-hour setup estimate, was being accumulated across 13 labor entries before this\n--   was caught and fixed -- variance against Epicor's native EARNEDHRS improved from\n--   +223% to +0.6% for affected operations). The earned amount is\n--   est_setup_hours * (1.0 if the operation or job is complete, else\n--   setup_pct_complete / 100.0) -- SETUPPCTCOMPLETE is Epicor's own cumulative\n--   percent-complete field for the setup function on that operation.\n--\n--   EARNED_HOURS_RAW_UNPRORATED / PERCENT_ALLOCATED (production's proration columns) are\n--   confirmed ProfitKey-specific (NULL on Kinetic, which has no equivalent) -- that\n--   mechanism is correctly out of scope here.\n--\n-- Validated against production's actual EARNED_HOURS_JOB_OPERATION, full 3-company\n-- population, before implementing: CDT 95.23% match (+0.20% aggregate), QTS 100.00%\n-- match (~0.0% aggregate), CCR 96.89% match (+0.10% aggregate) -- an order of magnitude\n-- better than every prior empirically-reverse-engineered iteration (best prior: CDT\n-- 78.62%/+2.58%, QTS 99.71%/-0.67%, CCR 71.88%/-1.99%).\n--\n-- This model now carries the Production RATE (per-unit) and the Setup CREDIT\n-- (operation-level, already a final amount, not a rate) side by side -- they combine\n-- additively at the fct_labor grain, not here, since Production is transaction-driven\n-- and Setup is operation-driven.\n\nwith job_operation as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_operation\n\n)\n\nselect\n    company_code,\n    job_num,\n    assembly_seqnum,\n    operation_seqnum,\n    operation_code,\n    run_quantity,\n    quantity_completed,\n    est_production_hours,\n    est_production_hours / nullif(run_quantity, 0) as production_std_hours_per_unit,  -- SD-26\n\n    est_setup_hours,\n    setup_pct_complete,\n    is_operation_complete,\n    is_job_complete,\n    est_setup_hours\n        * case\n            when is_operation_complete then 1.0  -- SD-26: OPERATION completion only, NOT job completion -- confirmed empirically (job 201143 op 10: jobcomplete=TRUE but opcomplete=FALSE, setuppctcomplete=0, and production credits 0, not the full est_setup_hours)\n            else coalesce(setup_pct_complete, 0) / 100.0\n          end as setup_earned_hours_credit,                                           -- SD-26\n\n    is_subcontract\nfrom job_operation", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:08.772819Z", "completed_at": "2026-10-28T19:44:08.780567Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:08.781157Z", "completed_at": "2026-10-28T19:44:09.827407Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 1.056025743484497, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.int_labor_detail", "compiled": true, "compiled_code": "\n\n-- Silver/intermediate: recomputed labor fact at the labor-transaction grain.\n--\n-- SD-26 (REVISED FOUNDATION): earned_hours is now computed for BOTH Production and Setup\n-- direct labor, per the corrected business rule (see int_labor_standard_hours header) --\n-- NOT just Production as SD-13 assumed. Indirect/Move still earn 0 (a real zero, no\n-- standard applies to them, matching production's own IS_DIRECT_LABOR definition).\n-- Rework still earns 0 at this grain (SD-13's rework exclusion is unaffected by SD-26).\n--\n-- Production (labor_type_pseudo='P', non-rework): earned_hours = quantity_produced *\n-- production_std_hours_per_unit, computed per transaction (transaction grain is correct\n-- -- confirmed directly against production's own SILVER.FACT_LABOR, which is itself a\n-- transaction-grain rollup, not an operation-level QUANTITY_COMPLETED-driven calculation\n-- as SD-19/23 assumed).\n--\n-- Setup (labor_type_pseudo='S', non-rework): earned_hours is NOT computed per transaction\n-- here -- it is a FIXED, OPERATION-level amount (setup_earned_hours_credit, from\n-- int_labor_standard_hours) that must be credited exactly ONCE per operation regardless of\n-- how many Setup labor transactions exist on it. Carrying the per-operation credit through\n-- on every Setup row here (rather than summing it per-transaction) would double/multiply\n-- count it when this table is later aggregated -- exactly the historical defect this rule\n-- corrects for (see int_labor_standard_hours header, job 200013 op 21). fct_labor is\n-- responsible for adding this credit in ONCE per operation (e.g. via MAX(), not SUM()),\n-- not by summing this column across Setup rows.\n--\n-- earned_hours can be LEGITIMATELY NEGATIVE (reversal/correction labor transactions carry\n-- negative quantity_produced -- confirmed against live data: all negative cases trace to\n-- negative quantity_produced with a positive standard rate, never a negative rate) and\n-- LEGITIMATELY NULL for Production rows whose operation standard is unresolved (no\n-- matching ERP_JOBOPER row, or a zero run_quantity denominator -- flagged via\n-- has_unresolved_standard below rather than silently defaulted to zero, per \"flag bad\n-- data, don't silently fix it\").\n--\n-- native_earned_hours_crosscheck (Epicor's own EARNEDHRS, carried from Bronze) is kept\n-- for comparison only -- never treated as the reported figure (SD-11).\n\nwith labor as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__labor_detail\n\n),\n\nstandard_hours as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours\n\n),\n\njob_header as (\n\n    select company_code, job_num, is_mrp_planning_job\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header\n\n)\n\nselect\n    labor.company_code,\n    labor.job_num,\n    labor.assembly_seqnum,\n    labor.operation_seqnum,\n    labor.labor_header_seqnum,\n    labor.labor_detail_seqnum,\n    labor.employee_num,\n    labor.jc_dept,\n    labor.resource_group_key,\n    labor.labor_type_code,\n    labor.labor_type_pseudo,\n    labor.is_rework,\n    labor.quantity_produced,\n    labor.quantity_scrapped,\n    labor.actual_hours,\n    labor.burden_hours,\n    labor.clock_in_date_text,\n    labor.payroll_date_text,\n    labor.fiscal_year,\n    labor.fiscal_period,\n    job_header.is_mrp_planning_job,\n\n    standard_hours.production_std_hours_per_unit,\n    case\n        when labor.labor_type_code = 'S' and not labor.is_rework\n            then standard_hours.setup_earned_hours_credit\n        else null\n    end as setup_earned_hours_credit,                                                  -- SD-26: only exposed on Setup rows, so fct_labor's MAX() naturally scopes the credit to operations with a real Setup transaction -- not every operation that happens to have a populated est_setup_hours\n\n    case\n        when labor.labor_type_code = 'P' and not labor.is_rework\n            then labor.quantity_produced * standard_hours.production_std_hours_per_unit\n        else 0\n    end as earned_hours,                                                             -- SD-26\n\n    (labor.labor_type_code = 'P' and not labor.is_rework\n        and standard_hours.production_std_hours_per_unit is null) as has_unresolved_standard,\n\n    labor.native_earned_hours_crosscheck\n\nfrom labor\nleft join standard_hours\n    on  labor.company_code      = standard_hours.company_code\n    and labor.job_num           = standard_hours.job_num\n    and labor.assembly_seqnum   = standard_hours.assembly_seqnum\n    and labor.operation_seqnum  = standard_hours.operation_seqnum\nleft join job_header\n    on  labor.company_code = job_header.company_code\n    and labor.job_num      = job_header.job_num", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:09.833140Z", "completed_at": "2026-10-28T19:44:09.843684Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:09.844390Z", "completed_at": "2026-10-28T19:44:10.844326Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.0126428604125977, "adapter_response": {"_message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor", "code": "skip", "rows_affected": -1}, "message": "skip SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.fct_labor", "compiled": true, "compiled_code": "\n\n-- Gold: the central fact, aggregated to company + job + assembly_seqnum + operation_seqnum\n-- -- the SAME grain as the reconciliation target (CTX_EARNED_HOURS_PRD.GOLD.\n-- EARNED_HOURS_JOB_OPERATION), confirmed via its own column list, so the next\n-- (reconciliation) step can compare row-for-row without a re-aggregation first.\n--\n-- department is deliberately NOT joined here -- production's own target grain doesn't\n-- carry it either (dim_department exists for future grains, not this one).\n--\n-- earned_hours is now the sum of two components (SD-26, replaces SD-19/SD-23/SD-24):\n-- (1) Production labor's per-transaction earned_hours, summed normally (transaction grain\n--     is correct, confirmed against production's own SILVER.FACT_LABOR); and\n-- (2) Setup's operation-level credit, added in ONCE via MAX() -- never SUM() -- since it is\n--     a fixed per-operation amount, not a per-transaction one. Summing it would\n--     double/multiply-count it across however many Setup labor transactions exist on the\n--     operation, which is the exact historical defect this rule corrects for (see\n--     int_labor_standard_hours header). See that model's header for the corrected\n--     root-cause history and the empirical validation (CDT 95.23%, QTS 100.00%, CCR\n--     96.89% match against production, all 3 companies).\n\nwith labor as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail\n\n),\n\nstandard_hours as (\n\n    select company_code, job_num, assembly_seqnum, operation_seqnum, quantity_completed\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours\n\n),\n\njob_header as (\n\n    select company_code, job_num, part_num, part_revision, is_mrp_planning_job\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header\n\n),\n\npart as (\n\n    select company_id, part_key, part_revision, part_dim_key\n    from SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part\n\n),\n\nlabor_with_part as (\n\n    select\n        labor.*,\n        job_header.part_num,\n        job_header.part_revision,\n        part.part_dim_key\n    from labor\n    left join job_header\n        on  labor.company_code = job_header.company_code\n        and labor.job_num      = job_header.job_num\n    left join part\n        on  job_header.company_code                                     = part.company_id\n        and job_header.part_num                                         = upper(trim(part.part_key))\n        and coalesce(job_header.part_revision, '')                      = coalesce(upper(trim(part.part_revision)), '')\n\n),\n\naggregated as (\n\n    select\n        company_code,\n        job_num,\n        assembly_seqnum,\n        operation_seqnum,\n        max(part_dim_key)                                               as part_dim_key,\n        max(is_mrp_planning_job)                                        as is_mrp_planning_job,\n\n        count(*)                                                        as labor_txns,\n        count(distinct employee_num)                                    as employees_involved,\n\n        sum(actual_hours)                                               as actual_hours,\n        sum(quantity_produced)                                          as txn_summed_quantity_produced,\n        sum(earned_hours)                                               as production_earned_hours,        -- SD-26\n        max(setup_earned_hours_credit)                                  as setup_earned_hours,              -- SD-26: MAX, not SUM\n        sum(case when has_unresolved_standard then 1 else 0 end)        as txns_no_computable_standard,\n\n        min(try_cast(clock_in_date_text as date))                       as first_labor_date,\n        max(try_cast(clock_in_date_text as date))                       as last_labor_date,\n\n        sum(native_earned_hours_crosscheck)                             as native_earned_hours_crosscheck\n\n    from labor_with_part\n    group by company_code, job_num, assembly_seqnum, operation_seqnum\n\n)\n\nselect\n    aggregated.*,\n    coalesce(aggregated.production_earned_hours, 0) + coalesce(aggregated.setup_earned_hours, 0) as earned_hours,  -- SD-26\n    standard_hours.quantity_completed                                   as quantity_produced\nfrom aggregated\nleft join standard_hours\n    on  aggregated.company_code     = standard_hours.company_code\n    and aggregated.job_num          = standard_hours.job_num\n    and aggregated.assembly_seqnum  = standard_hours.assembly_seqnum\n    and aggregated.operation_seqnum = standard_hours.operation_seqnum", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-28T19:44:10.850098Z", "completed_at": "2026-10-28T19:44:10.857375Z"}, {"name": "execute", "started_at": "2026-10-28T19:44:10.857990Z", "completed_at": "2026-10-28T19:44:11.667782Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.8191030025482178, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c809e0-0109-6965-0002-921610ede24e"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.ctx_earned_hours_shadow.rec_labor_job_operation", "compiled": true, "compiled_code": "-- Reconciliation (diagnostic, point-in-time -- NOT a permanent pipeline layer). Compares\n-- this build's fct_labor against the production reconciliation target at the SAME grain:\n-- company+job+operation_seqnum (LOT is always NULL for Kinetic -- confirmed against live\n-- data, so it is dropped; assembly_seqnum is summed away here too -- checked that every\n-- job+operation combo with >1 assembly is an MRP-D% placeholder planning job with zero\n-- real labor, so this causes no practical divergence for real production jobs).\n--\n-- This view's purpose is transitional: once a decision is made on this build vs.\n-- production, it has done its job and can be retired -- unlike Bronze/Silver/Gold, which\n-- are meant to persist regardless of outcome.\n\nwith shadow as (\n\n    select\n        company_code,\n        job_num,\n        operation_seqnum,\n        sum(earned_hours)                     as earned_hours,\n        sum(actual_hours)                     as actual_hours,\n        sum(quantity_produced)                as quantity_produced,\n        sum(labor_txns)                        as labor_txns,\n        max(employees_involved)                as employees_involved,\n        sum(txns_no_computable_standard)       as txns_no_computable_standard,\n        max(is_mrp_planning_job)               as is_mrp_planning_job,\n        max(case when part_dim_key is null then 1 else 0 end) as part_unmatched\n    from SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor\n    group by company_code, job_num, operation_seqnum\n\n),\n\nproduction as (\n\n    select\n        company_code,\n        job                                    as job_num,\n        operation_seqnum,\n        earned_hours                           as prod_earned_hours,\n        actual_hours                           as prod_actual_hours,\n        quantity_produced                      as prod_quantity_produced,\n        labor_txns                             as prod_labor_txns,\n        employees_involved                     as prod_employees_involved\n    from CTX_EARNED_HOURS_PRD.GOLD.EARNED_HOURS_JOB_OPERATION\n    where company_code in ('CTX11002', 'CTX11003', 'CTX11101')\n\n)\n\nselect\n    coalesce(shadow.company_code, production.company_code)      as company_code,\n    coalesce(shadow.job_num, production.job_num)                as job_num,\n    coalesce(shadow.operation_seqnum, production.operation_seqnum) as operation_seqnum,\n\n    shadow.earned_hours                        as shadow_earned_hours,\n    production.prod_earned_hours,\n    shadow.earned_hours - production.prod_earned_hours            as delta,\n    case\n        when production.prod_earned_hours = 0 or production.prod_earned_hours is null then null\n        else (shadow.earned_hours - production.prod_earned_hours) / abs(production.prod_earned_hours)\n    end                                         as pct_diff,\n\n    case\n        when shadow.company_code is null then 'ONLY_IN_PROD'\n        when production.company_code is null then 'ONLY_IN_SHADOW'\n        when abs(coalesce(shadow.earned_hours, 0) - coalesce(production.prod_earned_hours, 0)) <= 0.01 then 'MATCH'\n        else 'MISMATCH'\n    end                                         as match_category,\n\n    shadow.actual_hours                        as shadow_actual_hours,\n    production.prod_actual_hours,\n    shadow.quantity_produced                   as shadow_quantity_produced,\n    production.prod_quantity_produced,\n    shadow.labor_txns                          as shadow_labor_txns,\n    production.prod_labor_txns,\n\n    shadow.txns_no_computable_standard,\n    shadow.part_unmatched,\n    shadow.is_mrp_planning_job\n\nfrom shadow\nfull outer join production\n    on  shadow.company_code     = production.company_code\n    and shadow.job_num          = production.job_num\n    and shadow.operation_seqnum = production.operation_seqnum", "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.PUBLIC.rec_labor_job_operation", "batch_results": null}], "elapsed_time": 13.032522678375244, "args": {"send_anonymous_usage_stats": false, "partial_parse": true, "partial_parse_file_diff": true, "empty": false, "print": true, "static_parser": true, "cache_selected_only": false, "log_path": "/tmp/dbt/logs", "require_explicit_package_overrides_for_builtin_materializations": true, "project_dir": "/tmp/dbt", "log_format": "default", "quiet": false, "target": "dev", "state_modified_compare_more_unrendered_values": false, "require_resource_names_without_spaces": false, "state_modified_compare_vars": false, "invocation_command": "dbt ", "printer_width": 80, "macro_debugging": false, "require_nested_cumulative_type_params": false, "skip_nodes_if_on_run_start_fails": false, "log_level": "info", "which": "run", "use_colors": true, "use_colors_file": true, "log_level_file": "debug", "introspect": true, "populate_cache": true, "log_format_file": "debug", "indirect_selection": "eager", "strict_mode": false, "defer": false, "log_file_max_bytes": 10485760, "select": [], "show_resource_report": false, "source_freshness_run_project_hooks": false, "exclude": [], "require_batched_execution_for_custom_microbatch_strategy": false, "warn_error_options": {"include": [], "exclude": []}, "write_json": true, "profiles_dir": "/tmp/dbt_effective_profiles_adbapcmh", "vars": {}, "favor_state": false, "version_check": true, "require_yaml_configuration_for_mf_time_spines": false}}*
