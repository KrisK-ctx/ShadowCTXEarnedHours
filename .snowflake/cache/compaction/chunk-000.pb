y": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/marts/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "GOLD", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "AUTO"}, "created_at": 1792704929.8183842, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='AUTO'\n    )\n}}\n\n-- Gold: conformed part dimension, reused read-only from the DW (SD-18) -- not rebuilt.\n-- Matches production's own REF_PART_DIM sourcing decision. Filtered to our 3 Kinetic\n-- companies only (ProfitKey's '14'/'32' excluded -- out of scope per SD-01).\n-- Key = part_dim_key, already provided by the DW (company + part + revision, resolved).\n\nselect\n    companyid_part_rev_source_parthk_key   as part_dim_key,\n    company_id,\n    part_number                            as part_key,\n    revision_number                        as part_revision,\n    part_source,\n    internal_part_number,\n    external_part_number,\n    part_desc,\n    part_desc_2,\n    revshortdesc                           as rev_short_desc,\n    revdescription                         as rev_description,\n    prod_code                              as product_code,\n    type_code,\n    part_class_desc,\n    commercial_category,\n    commercial_sub_category,\n    approved,\n    approved_date,\n    effective_date,\n    part_uses_inventory,\n    part_deleted_date,\n    part_deleted_flag,\n    part_rev_deleted_date,\n    part_rev_deleted_flag,\n    part_intro_date,\n    part_age_years,\n    part_age_months\nfrom {{ source('prd_dw', 'T_DIMPART_ALLERPS') }}\nwhere company_id in ('CTX11002', 'CTX11003', 'CTX11101')", "language": "sql", "refs": [], "sources": [["prd_dw", "T_DIMP