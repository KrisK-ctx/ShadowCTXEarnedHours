_null_int_labor_detail_earned_hours", "checksum": {"name": "none", "checksum": ""}, "config": {"enabled": true, "alias": null, "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "WARN", "store_failures": null, "store_failures_as": null, "where": null, "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {"severity": "WARN"}, "created_at": 1792792142.7085664, "relation_name": null, "raw_code": "{{ test_not_null(**_dbt_generic_test_kwargs) }}{{ config(severity=\"warn\") }}", "language": "sql", "refs": [{"name": "int_labor_detail", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.dbt.test_not_null"], "nodes": ["model.ctx_earned_hours_shadow.int_labor_detail"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "column_name": "earned_hours", "file_key_name": "models.int_labor_detail", "attached_node": "model.ctx_earned_hours_shadow.int_labor_detail", "test_metadata": {"name": "not_null", "kwargs": {"column_name": "earned_hours", "model": "{{ get_where_subquery(ref('int_labor_detail')) }}"}, "namespace": null}}, "test.ctx_earned_hours_shadow.assert_setup_credited_once_per_operation": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "assert_setup_credited_once_per_operation", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "assert_setup_credited_once_per_operation.sql", "original_file_path": "tests/assert_setup_credited_once_per_operation.sql", "unique_id": "test.ctx_earned_hours_shadow.assert_setup_credited_once_per_operation", "fqn": ["ctx_earned_hours_shadow", "assert_setup_credited_once_per_operation"], "alias": "assert_setup_credited_once_per_operation", "checksum": {"name": "sha256", "checksum": "ec05ccbbdda85b20e466d011d81d633faf3a6b10db4bfe309c6a719420f7c61e"}, "config": {"enabled": true, "alias": null, "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "ERROR", "store_failures": null, "store_failures_as": null, "where": null, "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {}, "created_at": 1792792265.6062715, "relation_name": null, "raw_code": "-- Singular test (SD-26): Setup's earned-hours credit is a FIXED, OPERATION-level amount\n-- that must be attributed exactly once per operation, regardless of how many Setup labor\n-- transactions exist on it (the historical defect this corrects for -- see\n-- int_labor_standard_hours header, job 200013 op 21: a 5-hour setup estimate was being\n-- accumulated across 13 labor entries before this was caught and fixed in the referenced\n-- business design process).\n--\n-- Asserts fct_labor.setup_earned_hours equals int_labor_standard_hours's own\n-- setup_earned_hours_credit exactly, for every operation that actually HAS at least one\n-- Setup labor transaction (operations with no Setup labor legitimately show NULL/0 in\n-- fct_labor regardless of what the raw operation-level credit would have been, which is\n-- correct, not a defect -- this test is scoped to only the operations where the credit\n-- should actually appear). If fct_labor's aggregation ever regresses from MAX() to SUM()\n-- (or an equivalent mistake), this test fails rather than silently re-introducing the\n-- double-counting defect.\n\nwith ops_with_setup_labor as (\n    select distinct company_code, job_num, assembly_seqnum, operation_seqnum\n    from {{ ref('int_labor_detail') }}\n    where setup_earned_hours_credit is not null\n)\nselect\n    f.company_code, f.job_num, f.assembly_seqnum, f.operation_seqnum,\n    f.setup_earned_hours, s.setup_earned_hours_credit\nfrom ops_with_setup_labor o\njoin {{ ref('fct_labor') }} as f\n    on  o.company_code     = f.company_code\n    and o.job_num          = f.job_num\n    and o.assembly_seqnum  = f.assembly_seqnum\n    and o.operation_seqnum = f.operation_seqnum\njoin {{ ref('int_labor_standard_hours') }} as s\n    on  f.company_code     = s.company_code\n    and f.job_num           = s.job_num\n    and f.assembly_seqnum   = s.assembly_seqnum\n    and f.operation_seqnum  = s.operation_seqnum\nwhere abs(coalesce(f.setup_earned_hours, 0) - coalesce(s.setup_earned_hours_credit, 0)) > 0.01", "language": "sql", "refs": [{"name": "int_labor_detail", "package": null, "version": null}, {"name": "fct_labor", "package": null, "version": null}, {"name": "int_labor_standard_hours", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": [], "nodes": ["model.ctx_earned_hours_shadow.int_labor_detail", "model.ctx_earned_hours_shadow.fct_labor", "model.ctx_earned_hours_shadow.int_labor_standard_hours"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}}}, "sources": {"source.ctx_earned_hours_shadow.prd_dw.V_CRETEX_CALENDAR_DATE_DIM": {"database": "PRD_DW", "schema": "DATAMART", "name": "V_CRETEX_CALENDAR_DATE_DIM", "resource_type": "source", "package_name": "ctx_earned_hours_shadow", "path": "models/marts/sources.yml", "original_file_path": "models/marts/sources.yml", "unique_id": "source.ctx_earned_hours_shadow.prd_dw.V_CRETEX_CALENDAR_DATE_DIM", "fqn": ["ctx_earned_hours_shadow", "marts", "prd_dw", "V_CRETEX_CALENDAR_DATE_DIM"], "source_name": "prd_dw", "source_description": "", "loader": "", "identifier": "V_CRETEX_CALENDAR_DATE_DIM", "quoting": {"database": null, "schema": null, "identifier": null, "column": null}, "loaded_at_field": null, "freshness": {"warn_after": {"coun