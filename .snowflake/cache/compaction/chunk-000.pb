": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "target_lag": "1 hour", "refresh_mode": "INCREMENTAL"}, "tags": [], "description": "The central fact, aggregated to company+job+assembly_seqnum+operation_seqnum -- the same grain as CTX_EARNED_HOURS_PRD.GOLD.EARNED_HOURS_JOB_OPERATION.\n", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "labor_txns": {"name": "labor_txns", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/marts/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "GOLD", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "INCREMENTAL"}, "created_at": 1792791696.576038, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='INCREMENTAL'\n    )\n}}\n\n-- Gold: the central fact, aggregated to company + job + assembly_seqnum + operation_seqnum\n-- -- the SAME grain as the reconciliation target (CTX_EARNED_HOURS_PRD.GOLD.\n-- EARNED_HOURS_JOB_OPERATION), confirmed via its own column list, so the next\n-- (reconciliation) step can compare row-for-row without a re-aggregation first.\n--\n-- department is deliberately NOT joined here -- production's own target grain doesn't\n-- carry it either (dim_department exists for future grains, not this one).\n--\n-- earned_hours is now the sum of two components (SD-26, replaces SD-19/SD-23/SD-24):\n-- (1) Production labor's per-transaction earned_hours, summed normally (transaction grain\n--     is correct, confirmed against production's own SILVER.FACT_LABOR); and\n-- (2) Setup's operation-level credit, added in ONCE via MAX() -- never SUM() -- since it is\n--     a fixed per-operation amount, not a per-transaction one. Summing it would\n--     double/multiply-count it across however many Setup labor transactions exist on the\n--     operation, which is the exact historical defect this rule corrects for (see\n--     int_labor_standard_hours header). See that model's header for the corrected\n--     root-cause history and the empirical validation (CDT 95.23%, QTS 100.00%, CCR\n--     96.89% match against production, all 3 companies).\n\nwith labor as (\n\n    select *\n    from {{ ref('int_labor_detail') }}\n\n),\n\nstandard_hours as (\n\n    select company_code, job_num, assembly_seqnum, operation_seqnum, quantity_completed\n    from {{ ref('int_labor_standard_hours') }}\n\n),\n\njob_header as (\n\n    select company_code, job_num, part_num, part_revision, is_mrp_planning_job\n    from {{ ref('stg_ctxepicorkinetic__job_header') }}\n\n),\n\npart as (\n\n    select company_id, part_key, part_revision, part_dim_key\n    from {{ ref('dim_part') }}\n\n),\n\nlabor_with_part as (\n\n    select\n        labor.*,\n        job_header.part_num,\n        job_header.part_revision,\n        part.part_dim_key\n    from labor\n    left join job_header\n        on  labor.company_code = job_header.company_code\n        and labor.job_num      = job_header.job_num\n    left join part\n        on  job_header.company_code                                     = part.company_id\n        and job_header.part_num                                         = upper(trim(part.part_key))\n        and coalesce(job_header.part_revision, '')                      = coalesce(upper(trim(part.part_revision)), '')\n\n),\n\naggregated as (\n\n    select\n        company_code,\n        job_num,\n        assembly_seqnum,\n        operation_seqnum,\n        max(part_dim_key)                                               as part_dim_key,\n        max(is_mrp_planning_job)                                        as is_mrp_planning_job,\n\n        count(*)                                                        as labor_txns,\n        count(distinct employee_num)                                    as employees_involved,\n\n        sum(actual_hours)                                               as actual_hours,\n        sum(quantity_produced)                                          as txn_summed_quantity_produced,\n        sum(earned_hours)                                               as production_earned_hours,        -- SD-26\n        max(setup_earned_hours_credit)                                  as setup_earned_hours,              -- SD-26: MAX, not SUM\n        sum(case when has_unresolved_standard then 1 else 0 end)        as txns_no_computable_standard,\n\n        min(try_cast(clock_in_date_text as date))                       as first_labor_date,\n        max(try_cast(clock_in_date_text as date))                       as last_labor_date,\n\n        sum(native_earned_hours_crosscheck)                             as native_earned_hours_crosscheck\n\n    from labor_with_part\n    group by company_code, job_num, assembly_seqnum, operation_seqnum\n\n)\n\nselect\n    aggregated.*,\n    coalesce(aggregated.production_earned_hours, 0) + coalesce(aggregated.setup_earned_hours, 0) as earned_hours,  -- SD-26\n    standard_hours.quantity_completed                                   as quantity_produced\nfrom aggregated\nleft join standard_hours\n    on  aggregated.company_code     = standard_hours.company_code\n    and aggregated.job_num          = standard_hours.job_num\n    and aggregated.assembly_seqnum  = standard_hours.assembly_seqnum\n    and aggregated.operation_seqnum = standard_hours.operation_seqnum", "language": "sql", "refs": [{"name": "int_labor_detail", "package": null, "version": null}, {"name": "int_labor_standard_hours", "package": null, "version": null}, {"name": "stg_ctxepicorkinetic__job_header", "package": null, "version": null}, {"name": "dim_part", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": [], "nodes": ["model.ctx_earned_hours_shadow.int_labor_detail", "model.ctx_earned_hours_shadow.int_labor_standard_hours", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_header", "model.ctx_earned_hours_shadow.dim_part"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/marts/fct_labor.sql", "compiled": true, "compiled_code": "\n\n-- Gold: the central fact, aggregated to company + job + assembly_seqnum + operation_seqnum\n-- -- the SAME grain as the reconciliation target (CTX_EARNED_HOURS_PRD.GOLD.\n-- EARNED_HOURS_JOB_OPERATION), confirmed via its own column list, so the next\n-- (reconciliation) step can compare row-for-row without a re-aggregation first.\n--\n-- department is deliberately NOT joined here -- production's own target grain doesn't\n-- carry it either (dim_department exists for future grains, not this one).\n--\n-- earned_hours is now the sum of two components (SD-26, replaces SD-19/SD-23/SD-24):\n-- (1) Production labor's per-transaction earned_hours, summed normally (transaction grain\n--     is correct, confirmed against production's own SILVER.FACT_LABOR); and\n-- (2) Setup's operation-level credit, added in ONCE via MAX() -- never SUM() -- since it is\n--     a fixed per-operation amount, not a per-transaction one. Summing it would\n--     double/multiply-count it across however many Setup labor transactions exist on the\n--     operation, which is the exact historical defect this rule corrects for (see\n--     int_labor_standard_hours header). See that model's header for the corrected\n--     root-cause history and the empirical validation (CDT 95.23%, QTS 100.00%, CCR\n--     96.89% match against production, all 3 companies).\n\nwith labor as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail\n\n),\n\nstandard_hours as (\n\n    select company_code, job_num, assembly_seqnum, operation_seqnum, quantity_completed\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours\n\n),\n\njob_header as (\n\n    select company_code, job_num, part_num, part_revision, is_mrp_planning_job\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header\n\n),\n\npart as (\n\n    select company_id, part_key, part_revision, part_dim_key\n    from SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_part\n\n),\n\nlabor_with_part as (\n\n    select\n        labor.*,\n        job_header.part_num,\n        job_header.part_revision,\n        part.part_dim_key\n    from labor\n    left join job_header\n        on  labor.company_code = job_header.company_code\n        and labor.job_num      = job_header.job_num\n    left join part\n        on  job_header.company_code                                     = part.company_id\n        and job_header.part_num                                         = upper(trim(part.part_key))\n        and coalesce(job_header.part_revision, '')                      = coalesce(upper(trim(part.part_revision)), '')\n\n),\n\naggregated as (\n\n    select\n        company_code,\n        job_num,\n        assembly_seqnum,\n        operation_seqnum,\n        max(part_dim_key)                                               as part_dim_key,\n        max(is_mrp_planning_job)                                        as is_mrp_planning_job,\n\n        count(*)                                                        as labor_txns,\n        count(distinct employee_num)                                    as employees_involved,\n\n        sum(actual_hours)                                               as actual_hours,\n        sum(quantity_produced)                                          as txn_summed_quantity_produced,\n        sum(earned_hours)                                               as production_earned_hours,        -- SD-26\n        max(setup_earned_hours_credit)                                  as setup_earned_hours,              -- SD-26: MAX, not SUM\n        sum(case when has_unresolved_standard then 1 else 0 end)        as txns_no_computable_standard,\n\n        min(try_cast(clock_in_date_text as date))                       as first_labor_date,\n        max(try_cast(clock_in_date_text as date))                       as last_labor_date,\n\n        sum(native_earned_hours_crosscheck)                             as native_earned_hours_crosscheck\n\n    from labor_with_part\n    group by company_code, job_num, assembly_seqnum, operation_seqnum\n\n)\n\nselect\n    aggregated.*,\n    coalesce(aggregated.production_earned_hours, 0) + coalesce(aggregated.setup_earned_hours, 0) as earned_hours,  -- SD-26\n    standard_hours.quantity_completed                                   as quantity_produced\nfrom aggregated\nleft join standard_hours\n    on  aggregated.company_code     = standard_hours.company_code\n    and aggregated.job_num          = standard_hours.job_num\n    and aggregated.assembly_seqnum  = standard_hours.assembly_seqnum\n    and aggregated.operation_seqnum = standard_hours.operation_seqnum", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "BRONZE", "name": "stg_ctxepicorkinetic__job_operation", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "staging/stg_ctxepicorkinetic__job_operation.sql", "original_file_path": "models/staging/stg_ctxepicorkinetic__job_operation.sql", "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation", "fqn": ["ctx_earned_hours_shadow", "staging", "stg_ctxepicorkinetic__job_operation"], "alias": "stg_ctxepicorkinetic__job_operation", "checksum": {"name": "sha256", "checksum": "ff38d9905488efc9ab3e6d378c0b20acd31c5d1d6a65ad7f76c64ae51e162967"}, "config": {"enabled": true, "alias": null, "schema": "BRONZE", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "incremental", "incremental_strategy": "merge", "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": ["company_code", "job_num", "assembly_seqnum", "operation_seqnum"], "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "Kinetic job operations -- the only place Kinetic standard hours live.", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "production_standard_raw": {"name": "production_standard_raw", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/staging/schema.yml", "build_path": "target/run/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__job_operation.sql", "unrendered_config": {"materialized": "incremental", "incremental_strategy": "merge", "schema": "BRONZE", "unique_key": ["company_code", "job_num", "assembly_seqnum", "operation_seqnum"]}, "created_at": 1792791696.5848083, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_operation", "raw_code": "{{\n    config(\n        unique_key=['company_code', 'job_num', 'assembly_seqnum', 'operation_seqnum']\n    )\n}}\n\n-- Bronze: Kinetic job operations -- the only place Kinetic standard hours live.\n-- Thin rename only. Gated by the enrollment view (SD-10). Carries BOTH candidate\n-- standards (est_production_hours = budget, NOT earned hours; production_standard_raw +\n-- standard_format = the per-unit rate Silver must convert and multiply by quantity\n-- produced -- SD-11). No conversion happens here; that is Silver's job.\n--\n-- SD-22: job_num and operation_code are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n--\n-- SD-26: setup_pct_complete added -- carries ERP_JOBOPER.SETUPPCTCOMPLETE, needed for the\n-- corrected Setup earned-hours formula (read from production's own documented business\n-- rules, not re-derived). See int_labor_standard_hours for the formula itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        subcontract             as is_subcontract,\n        runqty                  as run_quantity,\n        estsethours             as est_setup_hours,\n        estprodhours            as est_production_hours,\n        prodstandard            as production_standard_raw,\n        stdformat               as standard_format,\n        stdbasis                as standard_basis,\n        opsperpart              as ops_per_part,\n        qtyper                  as quantity_per,\n        qtypercycle             as quantity_per_cycle,\n        actprodhours            as act_production_hours,\n        actsetuphours           as act_setup_hours,\n        qtycompleted            as quantity_completed,\n        setuppctcomplete        as setup_pct_complete,\n        jobengineered           as is_job_engineered,\n        opcomplete              as is_operation_complete,\n        jobcomplete             as is_job_complete,\n        sysrevid                as _sysrevid\n    from {{ source('ctxepicorkinetic', 'ERP_JOBOPER') }}\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join {{ ref('stg_ctxepicorkinetic__company_enrollment') }} as gate\n    on source.company_code = gate.company_code\nwhere source.company_code <> '000000'  -- junk placeholder company, not a real enrolled company", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__company_enrollment", "package": null, "version": null}], "sources": [["ctxepicorkinetic", "ERP_JOBOPER"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctxepicorkinetic.ERP_JOBOPER", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__job_operation.sql", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job operations -- the only place Kinetic standard hours live.\n-- Thin rename only. Gated by the enrollment view (SD-10). Carries BOTH candidate\n-- standards (est_production_hours = budget, NOT earned hours; production_standard_raw +\n-- standard_format = the per-unit rate Silver must convert and multiply by quantity\n-- produced -- SD-11). No conversion happens here; that is Silver's job.\n--\n-- SD-22: job_num and operation_code are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n--\n-- SD-26: setup_pct_complete added -- carries ERP_JOBOPER.SETUPPCTCOMPLETE, needed for the\n-- corrected Setup earned-hours formula (read from production's own documented business\n-- rules, not re-derived). See int_labor_standard_hours for the formula itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        subcontract             as is_subcontract,\n        runqty                  as run_quantity,\n        estsethours             as est_setup_hours,\n        estprodhours            as est_production_hours,\n        prodstandard            as production_standard_raw,\n        stdformat               as standard_format,\n        stdbasis                as standard_basis,\n        opsperpart              as ops_per_part,\n        qtyper                  as quantity_per,\n        qtypercycle             as quantity_per_cycle,\n        actprodhours            as act_production_hours,\n        actsetuphours           as act_setup_hours,\n        qtycompleted            as quantity_completed,\n        setuppctcomplete        as setup_pct_complete,\n        jobengineered           as is_job_engineered,\n        opcomplete              as is_operation_complete,\n        jobcomplete             as is_job_complete,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JOBOPER\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code\nwhere source.company_code <> '000000'  -- junk placeholder company, not a real enrolled company", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "test.ctx_earned_hours_shadow.not_null_fct_labor_company_code.2978fa1a74": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "not_null_fct_labor_company_code", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "not_null_fct_labor_company_code.sql", "original_file_path": "models/marts/schema.yml", "unique_id": "test.ctx_earned_hours_shadow.not_null_fct_labor_company_code.2978fa1a74", "fqn": ["ctx_earned_hours_shadow", "marts", "not_null_fct_labor_company_code"], "alias": "not_null_fct_labor_company_code", "checksum": {"name": "none", "checksum": ""}, "config": {"enabled": true, "alias": null, "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "ERROR", "store_failures": null, "store_failures_as": null, "where": null, "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {}, "created_at": 1792791696.57728, "relation_name": null, "raw_code": "{{ test_not_null(**_dbt_generic_test_kwargs) }}", "language": "sql", "refs": [{"name": "fct_labor", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.dbt.test_not_null"], "nodes": ["model.ctx_earned_hours_shadow.fct_labor"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "column_name": "company_code", "file_key_name": "models.fct_labor", "attached_node": "model.ctx_earned_hours_shadow.fct_labor", "test_metadata": {"name": "not_null", "kwargs": {"column_name": "company_code", "model": "{{ get_where_subquery(ref('fct_labor')) }}"}, "namespace": null}}, "test.ctx_earned_hours_shadow.not_null_fct_labor_labor_txns.24e9302a03": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "not_null_fct_labor_labor_txns", 