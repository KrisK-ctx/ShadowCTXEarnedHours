me": "ctx_earned_hours_shadow", "path": "marts/dim_department.sql", "original_file_path": "models/marts/dim_department.sql", "unique_id": "model.ctx_earned_hours_shadow.dim_department", "fqn": ["ctx_earned_hours_shadow", "marts", "dim_department"], "alias": "dim_department", "checksum": {"name": "sha256", "checksum": "5b0aaaa2290418c8ee69a99d773560e5f240b6ef76d81b3ce6ae6bd859a7c4fb"}, "config": {"enabled": true, "alias": null, "schema": "GOLD", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "dynamic_table", "incremental_strategy": null, "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "target_lag": "1 hour", "refresh_mode": "INCREMENTAL"}, "tags": [], "description": "Conformed department dimension. Not joined into fct_labor (SD matches production's own grain).", "columns": {"department_key": {"name": "department_key", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/marts/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "GOLD", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "INCREMENTAL"}, "created_at": 1792704929.8212662, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_department", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='INCREMENTAL'\n    )\n}}\n\n-- Gold: conformed department dimension, from Bronze. Built for completeness/future\n-- grains -- NOT joined into fct_labor below, since production's own\n-- EARNED_HOURS_JOB_OPERATION grain doesn't carry department either (verified via its\n-- column list: job/operation/part/resource, no department).\n\nselect\n    {{ generate_surrogate_key(['company_code', 'jc_dept']) }} as department_key,\n    company_code,\n    jc_dept,\n    department_description,\n    is_global_jc_dept\nfrom {{ ref('stg_ctxepicorkinetic__department') }}", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__department", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.ctx_earned_hours_shadow.generate_surrogate_key"], "nodes": ["model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__department"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/marts/dim_department.sql", "compiled": true, "compiled_code": "\n\n-- Gold: conformed department dimension, from Bronze. Built for completeness/future\n-- grains -- NOT joined into fct_labor below, since production's own\n-- EARNED_HOURS_JOB_OPERATION grain doesn't carry department either (verified via its\n-- column list: job/operation/part/resource, no department).\n\nselect\n    md5(concat_ws('|',coalesce(cast(company_code as varchar), '_surrogate_key_null_'),coalesce(cast(jc_dept as varchar), '_surrogate_key_null_'))) as department_key,\n    company_code,\n    jc_dept,\n    department_description,\n    is_global_jc_dept\nfrom SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__department", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": ["department_key"], "time_spine": null}, "model.ctx_earned_hours_shadow.dim_emp