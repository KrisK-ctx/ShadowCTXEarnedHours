g='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='INCREMENTAL'\n    )\n}}\n\n-- Gold: conformed employee dimension, from Bronze.\n\nselect\n    {{ generate_surrogate_key(['company_code', 'emp_id']) }} as employee_key,\n    company_code,\n    emp_id,\n    full_name,\n    first_name,\n    last_name,\n    jc_dept,\n    shift_num,\n    labor_rate,\n    employee_status,\n    is_production_worker,\n    enrollment_date_text,\n    departure_date_text\nfrom {{ ref('stg_ctxepicorkinetic__employee') }}", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__employee", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.ctx_earned_hours_shadow.generate_surrogate_key"], "nodes": ["model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__employee"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/marts/dim_employee.sql", "compiled": true, "compiled_code": "\n\n-- Gold: conformed employee dimension, from Bronze.\n\nselect\n    md5(concat_ws('|',coalesce(cast(company_code as varchar), '_surrogate_key_null_'),coalesce(cast(emp_id as varchar), '_surrogate_key_null_'))) as employee_key,\n    company_code,\n    emp_id,\n    full_name,\n    first_name,\n    last_name,\n    jc_dept,\n    shift_num,\n    labor_rate,\n    employee_status,\n    is_production_worker,\n    enrollment_date_text,\n    departure_date_text\nfrom SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__employee", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": ["employee_key"], "time_spine": null}, "model.ctx_earned_hours_shadow.rec_labor_job_operation": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "PUBLIC", "name": "rec_labor_job_operation", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "reconciliation/rec_labor_job_operation.sql", "original_file_path": "models/reconciliation/rec_labor_job_operation.sql", "unique_id": "model.ctx_earned_hours_shadow.rec_labor_job_operation", "fqn": ["ctx_earned_hours_shadow", "reconciliation", "rec_labor_job_operation"], "alias": "rec_labor_job_operation", "checksum": {"name": "sha256", "checksum": "22418c74d4ef935b137731ab001e499a50c0ac3331699746156670604a126513"}, "config": {"enabled": true, "alias": null, "schema": "PUBLIC", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "view", "incremental_strategy": null, "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": "target/run/ctx_earned_hours_shadow/models/reconciliation/rec_labor_job_operation.sql", "unrendered_config": {"materialized": "view", "schema": "PUBLIC"}, "created_at": 1792704929.3217406, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.PUBLIC.rec_labor_job_operation", "raw_code": "-- Reconciliation (diagnostic, point-in-time -- NOT a permanent pipeline layer). Compares\n-- this build's fct_labor against the production reconciliation target at the SAME grain:\n-- company+job+operation_seqnum (LOT is always NULL for Kinetic -- confirmed against live\n-- data, so it is dropped; assembly_seqnum is summed away here too -- checked that every\n-- job+operation combo with >1 assembly is an MRP-D% placeholder planning job with zero\n-- real labor, so this causes no practical divergence for real production jobs).\n--\n-- This view's purpose is transitional: once a decision is made on this build vs.\n-- production, it has done its job and can be retired -- unlike Bronze/Silver/Gold, which\n-- are meant to persist regardless of outcome.\n\nwith shadow as (\n\n    select\n        company_code,\n        job_num,\n        operation_seqnum,\n        sum(earned_hours)                     as earned_hours,\n        sum(actual_hours)                     as actual_hours,\n        sum(quantity_produced)                as quantity_produced,\n        sum(labor_txns)                        as labor_txns,\n        max(employees_involved)                as employees_involved,\n        sum(txns_no_computable_standard)       as txns_no_computable_standard,\n        max(is_mrp_planning_job)               as is_mrp_planning_job,\n        max(case when part_dim_key is null then 1 else 0 end) as part_unmatched\n    from {{ ref('fct_labor') }}\n    group by company_code, job_num, operation_seqnum\n\n),\n\nproduction as (\n\n    select\n        company_code,\n        job                                    as job_num,\n        operation_seqnum,\n        earned_hours                           as prod_earned_hours,\n        actual_hours                           as prod_actual_hours,\n        quantity_produced                      as prod_quantity_produced,\n        labor_txns                             as prod_labor_txns,\n        employees_involved                     as prod_employees_involved\n    from {{ source('ctx_earned_hours_prd', 'EARNED_HOURS_JOB_OPERATION') }}\n    where company_code in ('CTX11002', 'CTX11003', 'CTX11101')\n\n)\n\nselect\n    coalesce(shadow.company_code, production.company_code)      as company_code,\n    coalesce(shadow.job_num, production.job_num)                as job_num,\n    coalesce(shadow.operation_seqnum, production.operation_seqnum) as operation_seqnum,\n\n    shadow.earned_hours                        as shadow_earned_hours,\n    production.prod_earned_hours,\n    shadow.earned_hours - production.prod_earned_hours            as delta,\n    case\n        when production.prod_earned_hours = 0 or production.prod_earned_hours is null then null\n        else (shadow.earned_hours - production.prod_earned_hours) / abs(production.prod_earned_hours)\n    end                                         as pct_diff,\n\n    case\n        when shadow.company_code is null then 'ONLY_IN_PROD'\n        when production.company_code is null then 'ONLY_IN_SHADOW'\n        when abs(coalesce(shadow.earned_hours, 0) - coalesce(production.prod_earned_hours, 0)) <= 0.01 then 'MATCH'\n        else 'MISMATCH'\n    end                                         as match_category,\n\n    shadow.actual_hours                        as shadow_actual_hours,\n    production.prod_actual_hours,\n    shadow.quantity_produced                   as shadow_quantity_produced,\n    production.prod_quantity_produced,\n    shadow.labor_txns                          as shadow_labor_txns,\n    production.prod_labor_txns,\n\n    shadow.txns_no_computable_standard,\n    shadow.part_unmatched,\n    shadow.is_mrp_planning_job\n\nfrom shadow\nfull outer join production\n    on  shadow.company_code     = production.company_code\n    and shadow.job_num          = production.job_num\n    and shadow.operation_seqnum = production.operation_seqnum", "language": "sql", "refs": [{"name": "fct_labor", "package": null, "version": null}], "sources": [["ctx_earned_hours_prd", "EARNED_HOURS_JOB_OPERATION"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctx_earned_hours_prd.EARNED_HOURS_JOB_OPERATION", "model.ctx_earned_hours_shadow.fct_labor"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/reconciliation/rec_labor_job_operation.sql", "compiled": true, "compiled_code": "-- Reconciliation (diagnostic, point-in-time -- NOT a permanent pipeline layer). Compares\n-- this build's fct_labor against the production reconciliation target at the SAME grain:\n-- company+job+operation_seqnum (LOT is always NULL for Kinetic -- confirmed against live\n-- data, so it is dropped; assembly_seqnum is summed away here too -- checked that every\n-- job+operation combo with >1 assembly is an MRP-D% placeholder planning job with zero\n-- real labor, so this causes no practical divergence for real production jobs).\n--\n-- This view's purpose is transitional: once a decision is made on this build vs.\n-- production, it has done its job and can be retired -- unlike Bronze/Silver/Gold, which\n-- are meant to persist regardless of outcome.\n\nwith shadow as (\n\n    select\n        company_code,\n        job_num,\n        operation_seqnum,\n        sum(earned_hours)                     as earned_hours,\n        sum(actual_hours)                     as actual_hours,\n        sum(quantity_produced)                as quantity_produced,\n        sum(labor_txns)                        as labor_txns,\n        max(employees_involved)                as employees_involved,\n        sum(txns_no_computable_standard)       as txns_no_computable_standard,\n        max(is_mrp_planning_job)               as is_mrp_planning_job,\n        max(case when part_dim_key is null then 1 else 0 end) as part_unmatched\n    from SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor\n    group by company_code, job_num, operation_seqnum\n\n),\n\nproduction as (\n\n    select\n        company_code,\n        job                                    as job_num,\n        operation_seqnum,\n        earned_hours                           as prod_earned_hours,\n        actual_hours                           as prod_actual_hours,\n        quantity_produced                      as prod_quantity_produced,\n        labor_txns                             as prod_labor_txns,\n        employees_involved                     as prod_employees_involved\n    from CTX_EARNED_HOURS_PRD.GOLD.EARNED_HOURS_JOB_OPERATION\n    where company_code in ('CTX11002', 'CTX11003', 'CTX11101')\n\n)\n\nselect\n    coalesce(shadow.company_code, production.company_code)      as company_code,\n    coalesce(shadow.job_num, production.job_num)                as job_num,\n    coalesce(shadow.operation_seqnum, production.operation_seqnum) as operation_seqnum,\n\n    shadow.earned_hours                        as shadow_earned_hours,\n    production.prod_earned_hours,\n    shadow.earned_hours - production.prod_earned_hours            as delta,\n    case\n        when production.prod_earned_hours = 0 or production.prod_earned_hours is null then null\n        else (shadow.earned_hours - production.prod_earned_hours) / abs(production.prod_earned_hours)\n    end                                         as pct_diff,\n\n    case\n        when shadow.company_code is null then 'ONLY_IN_PROD'\n        when production.company_code is null then 'ONLY_IN_SHADOW'\n        when abs(coalesce(shadow.earned_hours, 0) - coalesce(production.prod_earned_hours, 0)) <= 0.01 then 'MATCH'\n        else 'MISMATCH'\n    end                                         as match_category,\n\n    shadow.actual_hours                        as shadow_actual_hours,\n    production.prod_actual_hours,\n    shadow.quantity_produced                   as shadow_quantity_produced,\n    production.prod_quantity_produced,\n    shadow.labor_txns                          as shadow_labor_txns,\n    production.prod_labor_txns,\n\n    shadow.txns_no_computable_standard,\n    shadow.part_unmatched,\n    shadow.is_mrp_planning_job\n\nfrom shadow\nfull outer join production\n    on  shadow.company_code     = production.company_code\n    and shadow.job_num          = production.job_num\n    and shadow.operation_seqnum = production.operation_seqnum", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine"