on_production_standard_raw", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "not_null_stg_ctxepicorkinetic__e492adc276f140c544ce19ff50bfe2b5.sql", "original_file_path": "models/staging/schema.yml", "unique_id": "test.ctx_earned_hours_shadow.not_null_stg_ctxepicorkinetic__job_operation_production_standard_raw.584d93aa61", "fqn": ["ctx_earned_hours_shadow", "staging", "not_null_stg_ctxepicorkinetic__job_operation_production_standard_raw"], "alias": "not_null_stg_ctxepicorkinetic__e492adc276f140c544ce19ff50bfe2b5", "checksum": {"name": "none", "checksum": ""}, "config": {"enabled": true, "alias": "not_null_stg_ctxepicorkinetic__e492adc276f140c544ce19ff50bfe2b5", "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "WARN", "store_failures": null, "store_failures_as": null, "where": "standard_format != 'HR'", "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {"alias": "not_null_stg_ctxepicorkinetic__e492adc276f140c544ce19ff50bfe2b5", "severity": "WARN", "where": "standard_format != 'HR'"}, "created_at": 1792791696.5888882, "relation_name": null, "raw_code": "{{ test_not_null(**_dbt_generic_test_kwargs) }}{{ config(severity=\"warn\",where=\"standard_format != 'HR'\",alias=\"not_null_stg_ctxepicorkinetic__e492adc276f140c544ce19ff50bfe2b5\") }}", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__job_operation", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.dbt.test_not_null"], "nodes": ["model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "column_name": "production_standard_raw", "file_key_name": "models.stg_ctxepicorkinetic__job_operation", "attached_node": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation", "test_metadata": {"name": "not_null", "kwargs": {"column_name": "production_standard_raw", "model": "{{ get_where_subquery(ref('stg_ctxepicorkinetic__job_operation')) }}"}, "namespace": null}}, "model.ctx_earned_hours_shadow.int_labor_standard_hours": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "SILVER", "name": "int_labor_standard_hours", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "intermediate/int_labor_standard_hours.sql", "original_file_path": "models/intermediate/int_labor_standard_hours.sql", "unique_id": "model.ctx_earned_hours_shadow.int_labor_standard_hours", "fqn": ["ctx_earned_hours_shadow", "intermediate", "int_labor_standard_hours"], "alias": "int_labor_standard_hours", "checksum": {"name": "sha256", "checksum": "04dc841ace4f990ca42224aa4245fa7293a1315cdb966ba2d2ffbd1df336f4fa"}, "config": {"enabled": true, "alias": null, "schema": "SILVER", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "dynamic_table", "incremental_strategy": null, "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "target_lag": "1 hour", "refresh_mode": "INCREMENTAL"}, "tags": [], "description": "Per-unit Production rate (est_production_hours/run_quantity) and operation-level Setup credit for every Kinetic job operation, per the corrected business rule (SD-26) read from production's own documented requirements.\n", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "job_num": {"name": "job_num", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/intermediate/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "SILVER", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "INCREMENTAL"}, "created_at": 1792791869.1432307, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='INCREMENTAL'\n    )\n}}\n\n-- Silver/intermediate: per-unit Production rate and operation-level Setup credit for every\n-- Kinetic job operation.\n--\n-- SD-26 (REVISED FOUNDATION -- replaces SD-14/SD-19/SD-23/SD-24): the prior several\n-- iterations of this model (a 9-way STANDARD_FORMAT conversion from PRODSTANDARD; an\n-- operation-level QUANTITY_COMPLETED-driven earned_hours; a conditional zero-standard\n-- setup-credit rule) were all built by reverse-engineering empirically from reconciliation\n-- data, not from the actual documented business rule. Reading production's own Silver\n-- column comments directly (CTX_EARNED_HOURS_PRD.SILVER.FACT_LABOR) plus the Cretex\n-- Medallion PoC Earned Hours Business Design Document surfaced the real rule, which is\n-- simpler than anything previously built here:\n--\n--   Production-type labor (labortypepseudo='P', non-rework): earns\n--   quantity_produced * (est_production_hours / run_quantity) per transaction.\n--   Kinetic's standard rate is read directly from Epicor's own pre-computed\n--   est_production_hours, NOT re-derived from PRODSTANDARD/STANDARD_FORMAT -- Epicor\n--   already applied whatever internal format math applies when it computed that\n--   estimate, so re-deriving it from raw fields was duplicating (and, per the 87.67%\n--   agreement rate measured empirically, occasionally disagreeing with) work Epicor had\n--   already done correctly.\n--\n--   Setup-type labor (labortypepseudo='S', non-rework): earns a FIXED amount per\n--   OPERATION (never multiplied by quantity -- \"Setup is a FIXED amount per operation,\n--   so dividing it by pieces is a category error\", per production's own column\n--   documentation), credited ONCE regardless of how many Setup labor transactions exist\n--   on that operation. This mirrors a documented historical defect in the Cretex\n--   business-design process itself: multiple Setup time entries against the same\n--   operation were once double/multiply-counting the setup budget (job 200013 op 21,\n--   a 5-hour setup estimate, was being accumulated across 13 labor entries before this\n--   was caught and fixed -- variance against Epicor's native EARNEDHRS improved from\n--   +223% to +0.6% for affected operations). The earned amount is\n--   est_setup_hours * (1.0 if the operation or job is complete, else\n--   setup_pct_complete / 100.0) -- SETUPPCTCOMPLETE is Epicor's own cumulative\n--   percent-complete field for the setup function on that operation.\n--\n--   EARNED_HOURS_RAW_UNPRORATED / PERCENT_ALLOCATED (production's proration columns) are\n--   confirmed ProfitKey-specific (NULL on Kinetic, which has no equivalent) -- that\n--   mechanism is correctly out of scope here.\n--\n-- Validated against production's actual EARNED_HOURS_JOB_OPERATION, full 3-company\n-- population, before implementing: CDT 95.23% match (+0.20% aggregate), QTS 100.00%\n-- match (~0.0% aggregate), CCR 96.89% match (+0.10% aggregate) -- an order of magnitude\n-- better than every prior empirically-reverse-engineered iteration (best prior: CDT\n-- 78.62%/+2.58%, QTS 99.71%/-0.67%, CCR 71.88%/-1.99%).\n--\n-- This model now carries the Production RATE (per-unit) and the Setup CREDIT\n-- (operation-level, already a final amount, not a rate) side by side -- they combine\n-- additively at the fct_labor grain, not here, since Production is transaction-driven\n-- and Setup is operation-driven.\n\nwith job_operation as (\n\n    select *\n    from {{ ref('stg_ctxepicorkinetic__job_operation') }}\n\n)\n\nselect\n    company_code,\n    job_num,\n    assembly_seqnum,\n    operation_seqnum,\n    operation_code,\n    run_quantity,\n    quantity_completed,\n    est_production_hours,\n    est_production_hours / nullif(run_quantity, 0) as production_std_hours_per_unit,  -- SD-26\n\n    est_setup_hours,\n    setup_pct_complete,\n    is_operation_complete,\n    is_job_complete,\n    est_setup_hours\n        * case\n            when is_operation_complete then 1.0  -- SD-26: OPERATION completion only, NOT job completion -- confirmed empirically (job 201143 op 10: jobcomplete=TRUE but opcomplete=FALSE, setuppctcomplete=0, and production credits 0, not the full est_setup_hours)\n            else coalesce(setup_pct_complete, 0) / 100.0\n          end as setup_earned_hours_credit,                                           -- SD-26\n\n    is_subcontract\nfrom job_operation", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__job_operation", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": [], "nodes": ["model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_operation"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/intermediate/int_labor_standard_hours.sql", "compiled": true, "compiled_code": "\n\n-- Silver/intermediate: per-unit Production rate and operation-level Setup credit for every\n-- Kinetic job operation.\n--\n-- SD-26 (REVISED FOUNDATION -- replaces SD-14/SD-19/SD-23/SD-24): the prior several\n-- iterations of this model (a 9-way STANDARD_FORMAT conversion from PRODSTANDARD; an\n-- operation-level QUANTITY_COMPLETED-driven earned_hours; a conditional zero-standard\n-- setup-credit rule) were all built by reverse-engineering empirically from reconciliation\n-- data, not from the actual documented business rule. Reading production's own Silver\n-- column comments directly (CTX_EARNED_HOURS_PRD.SILVER.FACT_LABOR) plus the Cretex\n-- Medallion PoC Earned Hours Business Design Document surfaced the real rule, which is\n-- simpler than anything previously built here:\n--\n--   Production-type labor (labortypepseudo='P', non-rework): earns\n--   quantity_produced * (est_production_hours / run_quantity) per transaction.\n--   Kinetic's standard rate is read directly from Epicor's own pre-computed\n--   est_production_hours, NOT re-derived from PRODSTANDARD/STANDARD_FORMAT -- Epicor\n--   already applied whatever internal format math applies when it computed that\n--   estimate, so re-deriving it from raw fields was duplicating (and, per the 87.67%\n--   agreement rate measured empirically, occasionally disagreeing with) work Epicor had\n--   already done correctly.\n--\n--   Setup-type labor (labortypepseudo='S', non-rework): earns a FIXED amount per\n--   OPERATION (never multiplied by quantity -- \"Setup is a FIXED amount per operation,\n--   so dividing it by pieces is a category error\", per production's own column\n--   documentation), credited ONCE regardless of how many Setup labor transactions exist\n--   on that operation. This mirrors a documented historical defect in the Cretex\n--   business-design process itself: multiple Setup time entries against the same\n--   operation were once double/multiply-counting the setup budget (job 200013 op 21,\n--   a 5-hour setup estimate, was being accumulated across 13 labor entries before this\n--   was caught and fixed -- variance against Epicor's native EARNEDHRS improved from\n--   +223% to +0.6% for affected operations). The earned amount is\n--   est_setup_hours * (1.0 if the operation or job is complete, else\n--   setup_pct_complete / 100.0) -- SETUPPCTCOMPLETE is Epicor's own cumulative\n--   percent-complete field for the setup function on that operation.\n--\n--   EARNED_HOURS_RAW_UNPRORATED / PERCENT_ALLOCATED (production's proration columns) are\n--   confirmed ProfitKey-specific (NULL on Kinetic, which has no equivalent) -- that\n--   mechanism is correctly out of scope here.\n--\n-- Validated against production's actual EARNED_HOURS_JOB_OPERATION, full 3-company\n-- population, before implementing: CDT 95.23% match (+0.20% aggregate), QTS 100.00%\n-- match (~0.0% aggregate), CCR 96.89% match (+0.10% aggregate) -- an order of magnitude\n-- better than every prior empirically-reverse-engineered iteration (best prior: CDT\n-- 78.62%/+2.58%, QTS 99.71%/-0.67%, CCR 71.88%/-1.99%).\n--\n-- This model now carries the Production RATE (per-unit) and the Setup CREDIT\n-- (operation-level, already a final amount, not a rate) side by side -- they combine\n-- additively at the fct_labor grain, not here, since Production is transaction-driven\n-- and Setup is operation-driven.\n\nwith job_operation as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_operation\n\n)\n\nselect\n    company_code,\n    job_num,\n    assembly_seqnum,\n    operation_seqnum,\n    operation_code,\n    run_quantity,\n    quantity_completed,\n    est_production_hours,\n    est_production_hours / nullif(run_quantity, 0) as production_std_hours_per_unit,  -- SD-26\n\n    est_setup_hours,\n    setup_pct_complete,\n    is_operation_complete,\n    is_job_complete,\n    est_setup_hours\n        * case\n            when is_operation_complete then 1.0  -- SD-26: OPERATION completion only, NOT job completion -- confirmed empirically (job 201143 op 10: jobcomplete=TRUE but opcomplete=FALSE, setuppctcomplete=0, and production credits 0, not the full est_setup_hours)\n            else coalesce(setup_pct_complete, 0) / 100.0\n          end as setup_earned_hours_credit,                                           -- SD-26\n\n    is_subcontract\nfrom job_operation", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "test.ctx_earned_hours_shadow.not_null_int_labor_standard_hours_company_code.8117e3cfe8": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "not_null_int_labor_standard_hours_company_code", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "not_null_int_labor_standard_hours_company_code.sql", "original_file_path": "models/intermediate/schema.yml", "unique_id": "test.ctx_earned_hours_shadow.not_null_int_labor_standard_hours_company_code.8117e3cfe8", "fqn": ["ctx_earned_hours_shadow", "intermediate", "not_null_int_labor_standard_hours_company_code"], "alias": "not_null_int_labor_standard_hours_company_code", "checksum": {"name": "none", "checksum": ""}, "config": {"enabled": true, "alias": null, "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "ERROR", "store_failures": null, "store_failures_as": null, "where": null, "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {}, "created_at": 1792791869.3029888, "relation_name": null, "raw_code": "{{ test_not_null(**_dbt_generic_test_kwargs) }}", "language": "sql", "refs": [{"name": "int_labor_standard_hours", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.dbt.test_not_null"], "nodes": ["model.ctx_earned_hours_shadow.int_labor_standard_hours"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "column_name": "company_code", "file_key_name": "models.int_labor_standard_hours", "attached_node": "model.ctx_earned_hours_shadow.int_labor_standard_hours", "test_metadata": {"name": "not_null", "kwargs": {"column_name": "company_code", "model": "{{ get_where_subquery(ref('int_labor_standard_hours')) }}"}, "namespace": null}}, "test.ctx_earned_hours_shadow.not_null_int_labor_standard_hours_job_num.9d1cd2e012": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "not_null_int_labor_standard_hours_job_num", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "not_null_int_labor_standard_hours_job_num.sql", "original_file_path": "models/intermediate/schema.yml", "unique_id": "test.ctx_earned_hours_shadow.not_null_int_labor_standard_hours_job_num.9d1cd2e012", "fqn": ["ctx_earned_hours_shadow", "intermediate", "not_null_int_labor_standard_hours_job_num"], "alias": "not_null_int_labor_standard_hours_job_num", "checksum": {"name": "none", "checksum": ""}, "config": {"enabled": true, "alias": null, "schema": "dbt_test__audit", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "test", "severity": "ERROR", "store_failures": null, "store_failures_as": null, "where": null, "limit": null, "fail_calc": "count(*)", "warn_if": "!= 0", "error_if": "!= 0"}, "tags": [], "description": "", "columns": {}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": null, "build_path": null, "unrendered_config": {}, "created_at": 1792791869.3054478, "relation_name": null, "raw_code": "{{ test_not_null(**_dbt_generic_test_kwargs) }}", "language": "sql", "refs": [{"name": "int_labor_standard_hours", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": ["macro.dbt.test_not_null"], "nodes": ["model.ctx_earned_hours_shadow.int_labor_standard_hours"]}, "compiled_path": null, "contract": {"enforced": false, "alias_types": true, "checksum": null}, "column_name": "job_num", "file_key_name": "models.int_labor_standard_hours", "attached_node": "model.ctx_earned_hours_shadow.int_labor_standard_hours", "test_metadata": {"name": "not_null", "kwargs": {"column_name": "job_num", "model": "{{ get_where_subquery(ref('int_labor_standard_hours')) }}"}, "namespace": null}}, "model.ctx_earned_hours_shadow.int_labor_detail": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "SILVER", "name": "int_labor_detail", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "intermediate/int_labor_detail.sql", "original_file_path": "models/intermediate/int_labor_detail.sql", "unique_id": "model.ctx_earned_hours_shadow.int_labor_detail", "fqn": ["ctx_earned_hours_shadow", "intermediate", "int_labor_detail"], "alias": "int_labor_detail", "checksum": {"name": "sha256", "checksum": "b90f5afecf0c7e3b50e6211bba1f2a8940c3062fb33e3d39cd28f68d72908fce"}, "config": {"enabled": true, "alias": null, "schema": "SILVER", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "dynamic_table", "incremental_strategy": null, "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": null, "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "target_lag": "1 hour", "refresh_mode": "INCREMENTAL"}, "tags": [], "description": "Recomputed labor fact at the labor-transaction grain. earned_hours covers both Production (quantity-driven, per transaction) and Setup (operation-level credit, carried but NOT summed here -- see fct_labor) direct labor (SD-26); Indirect/Move/ rework are a real zero.\n", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "earned_hours": {"name": "earned_hours", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/intermediate/schema.yml", "build_path": null, "unrendered_config": {"materialized": "dynamic_table", "schema": "SILVER", "target_lag": "1 hour", "snowflake_warehouse": "COMPUTE_WH_CTX_SCIMDEFAULT", "refresh_mode": "INCREMENTAL"}, "created_at": 1792792142.5393143, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail", "raw_code": "{{\n    config(\n        materialized='dynamic_table',\n        target_lag='1 hour',\n        snowflake_warehouse='COMPUTE_WH_CTX_SCIMDEFAULT',\n        refresh_mode='INCREMENTAL'\n    )\n}}\n\n-- Silver/intermediate: recomputed labor fact at the labor-transaction grain.\n--\n-- SD-26 (REVISED FOUNDATION): earned_hours is now computed for BOTH Production and Setup\n-- direct labor, per the corrected business rule (see int_labor_standard_hours header) --\n-- NOT just Production as SD-13 assumed. Indirect/Move still earn 0 (a real zero, no\n-- standard applies to them, matching production's own IS_DIRECT_LABOR definition).\n-- Rework still earns 0 at this grain (SD-13's rework exclusion is unaffected by SD-26).\n--\n-- Production (labor_type_pseudo='P', non-rework): earned_hours = quantity_produced *\n-- production_std_hours_per_unit, computed per transaction (transaction grain is correct\n-- -- confirmed directly against production's own SILVER.FACT_LABOR, which is itself a\n-- transaction-grain rollup, not an operation-level QUANTITY_COMPLETED-driven calculation\n-- as SD-19/23 assumed).\n--\n-- Setup (labor_type_pseudo='S', non-rework): earned_hours is NOT computed per transaction\n-- here -- it is a FIXED, OPERATION-level amount (setup_earned_hours_credit, from\n-- int_labor_standard_hours) that must be credited exactly ONCE per operation regardless of\n-- how many Setup labor transactions exist on it. Carrying the per-operation credit through\n-- on every Setup row here (rather than summing it per-transaction) would double/multiply\n-- count it when this table is later aggregated -- exactly the historical defect this rule\n-- corrects for (see int_labor_standard_hours header, job 200013 op 21). fct_labor is\n-- responsible for adding this credit in ONCE per operation (e.g. via MAX(), not SUM()),\n-- not by summing this column across Setup rows.\n--\n-- earned_hours can be LEGITIMATELY NEGATIVE (reversal/correction labor transactions carry\n-- negative quantity_produced -- confirmed against live data: all negative cases trace to\n-- negative quantity_produced with a positive standard rate, never a negative rate) and\n-- LEGITIMATELY NULL for Production rows whose operation standard is unresolved (no\n-- matching ERP_JOBOPER row, or a zero run_quantity denominator -- flagged via\n-- has_unresolved_standard below rather than silently defaulted to zero, per \"flag bad\n-- data, don't silently fix it\").\n--\n-- native_earned_hours_crosscheck (Epicor's own EARNEDHRS, carried from Bronze) is kept\n-- for comparison only -- never treated as the reported figure (SD-11).\n\nwith labor as (\n\n    select *\n    from {{ ref('stg_ctxepicorkinetic__labor_detail') }}\n\n),\n\nstandard_hours as (\n\n    select *\n    from {{ ref('int_labor_standard_hours') }}\n\n),\n\njob_header as (\n\n    select company_code, job_num, is_mrp_planning_job\n    from {{ ref('stg_ctxepicorkinetic__job_header') }}\n\n)\n\nselect\n    labor.company_code,\n    labor.job_num,\n    labor.assembly_seqnum,\n    labor.operation_seqnum,\n    labor.labor_header_seqnum,\n    labor.labor_detail_seqnum,\n    labor.employee_num,\n    labor.jc_dept,\n    labor.resource_group_key,\n    labor.labor_type_code,\n    labor.labor_type_pseudo,\n    labor.is_rework,\n    labor.quantity_produced,\n    labor.quantity_scrapped,\n    labor.actual_hours,\n    labor.burden_hours,\n    labor.clock_in_date_text,\n    labor.payroll_date_text,\n    labor.fiscal_year,\n    labor.fiscal_period,\n    job_header.is_mrp_planning_job,\n\n    standard_hours.production_std_hours_per_unit,\n    case\n        when labor.labor_type_code = 'S' and not labor.is_rework\n            then standard_hours.setup_earned_hours_credit\n        else null\n    end as setup_earned_hours_credit,                                                  -- SD-26: only exposed on Setup rows, so fct_labor's MAX() naturally scopes the credit to operations with a real Setup transaction -- not every operation that happens to have a populated est_setup_hours\n\n    case\n        when labor.labor_type_code = 'P' and not labor.is_rework\n            then labor.quantity_produced * standard_hours.production_std_hours_per_unit\n        else 0\n    end as earned_hours,                                                             -- SD-26\n\n    (labor.labor_type_code = 'P' and not labor.is_rework\n        and standard_hours.production_std_hours_per_unit is null) as has_unresolved_standard,\n\n    labor.native_earned_hours_crosscheck\n\nfrom labor\nleft join standard_hours\n    on  labor.company_code      = standard_hours.company_code\n    and labor.job_num           = standard_hours.job_num\n    and labor.assembly_seqnum   = standard_hours.assembly_seqnum\n    and labor.operation_seqnum  = standard_hours.operation_seqnum\nleft join job_header\n    on  labor.company_code = job_header.company_code\n    and labor.job_num      = job_header.job_num", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__labor_detail", "package": null, "version": null}, {"name": "int_labor_standard_hours", "package": null, "version": null}, {"name": "stg_ctxepicorkinetic__job_header", "package": null, "version": null}], "sources": [], "metrics": [], "depends_on": {"macros": [], "nodes": ["model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__labor_detail", "model.ctx_earned_hours_shadow.int_labor_standard_hours", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_header"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/intermediate/int_labor_detail.sql", "compiled": true, "compiled_code": "\n\n-- Silver/intermediate: recomputed labor fact at the labor-transaction grain.\n--\n-- SD-26 (REVISED FOUNDATION): earned_hours is now computed for BOTH Production and Setup\n-- direct labor, per the corrected business rule (see int_labor_standard_hours header) --\n-- NOT just Production as SD-13 assumed. Indirect/Move still earn 0 (a real zero, no\n-- standard applies to them, matching production's own IS_DIRECT_LABOR definition).\n-- Rework still earns 0 at this grain (SD-13's rework exclusion is unaffected by SD-26).\n--\n-- Production (labor_type_pseudo='P', non-rework): earned_hours = quantity_produced *\n-- production_std_hours_per_unit, computed per transaction (transaction grain is correct\n-- -- confirmed directly against production's own SILVER.FACT_LABOR, which is itself a\n-- transaction-grain rollup, not an operation-level QUANTITY_COMPLETED-driven calculation\n-- as SD-19/23 assumed).\n--\n-- Setup (labor_type_pseudo='S', non-rework): earned_hours is NOT computed per transaction\n-- here -- it is a FIXED, OPERATION-level amount (setup_earned_hours_credit, from\n-- int_labor_standard_hours) that must be credited exactly ONCE per operation regardless of\n-- how many Setup labor transactions exist on it. Carrying the per-operation credit through\n-- on every Setup row here (rather than summing it per-transaction) would double/multiply\n-- count it when this table is later aggregated -- exactly the historical defect this rule\n-- corrects for (see int_labor_standard_hours header, job 200013 op 21). fct_labor is\n-- responsible for adding this credit in ONCE per operation (e.g. via MAX(), not SUM()),\n-- not by summing this column across Setup rows.\n--\n-- earned_hours can be LEGITIMATELY NEGATIVE (reversal/correction labor transactions carry\n-- negative quantity_produced -- confirmed against live data: all negative cases trace to\n-- negative quantity_produced with a positive standard rate, never a negative rate) and\n-- LEGITIMATELY NULL for Production rows whose operation standard is unresolved (no\n-- matching ERP_JOBOPER row, or a zero run_quantity denominator -- flagged via\n-- has_unresolved_standard below rather than silently defaulted to zero, per \"flag bad\n-- data, don't silently fix it\").\n--\n-- native_earned_hours_crosscheck (Epicor's own EARNEDHRS, carried from Bronze) is kept\n-- for comparison only -- never treated as the reported figure (SD-11).\n\nwith labor as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__labor_detail\n\n),\n\nstandard_hours as (\n\n    select *\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours\n\n),\n\njob_header as (\n\n    select company_code, job_num, is_mrp_planning_job\n    from SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header\n\n)\n\nselect\n    labor.company_code,\n    labor.job_num,\n    labor.assembly_seqnum,\n    labor.operation_seqnum,\n    labor.labor_header_seqnum,\n    labor.labor_detail_seqnum,\n    labor.employee_num,\n    labor.jc_dept,\n    labor.resource_group_key,\n    labor.labor_type_code,\n    labor.labor_type_pseudo,\n    labor.is_rework,\n    labor.quantity_produced,\n    labor.quantity_scrapped,\n    labor.actual_hours,\n    labor.burden_hours,\n    labor.clock_in_date_text,\n    labor.payroll_date_text,\n    labor.fiscal_year,\n    labor.fiscal_period,\n    job_header.is_mrp_planning_job,\n\n    standard_hours.production_std_hours_per_unit,\n    case\n        when labor.labor_type_code = 'S' and not labor.is_rework\n            then standard_hours.setup_earned_hours_credit\n        else null\n    end as setup_earned_hours_credit,                                                  -- SD-26: only exposed on Setup rows, so fct_labor's MAX() naturally scopes the credit to operations with a real Setup transaction -- not every operation that happens to have a populated est_setup_hours\n\n    case\n        when labor.labor_type_code = 'P' and not labor.is_rework\n            then labor.quantity_produced * standard_hours.production_std_hours_per_unit\n        else 0\n    end as earned_hours,                                                             -- SD-26\n\n    (labor.labor_type_code = 'P' and not labor.is_rework\n        and standard_hours.production_std_hours_per_unit is null) as has_unresolved_standard,\n\n    labor.native_earned_hours_crosscheck\n\nfrom labor\nleft join standard_hours\n    on  labor.company_code      = standard_hours.company_code\n    and labor.job_num           = standard_hours.job_num\n    and labor.assembly_seqnum   = standard_hours.assembly_seqnum\n    and labor.operation_seqnum  = standard_hours.operation_seqnum\nleft join job_header\n    on  labor.company_code = job_header.company_code\n    and labor.job_num      = job_header.job_num", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "test.ctx_earned_hours_shadow.not_null_int_labor_detail_company_code.046945ad0d": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "dbt_test__audit", "name": "not_null_int_labor_detail_company_code", "resource_type": "test", "package_name": "ctx_earned_hours_shadow", "path": "not_null_int_labor_detail_company_code.sql", "original_file_path": "models/intermediate/schema.yml", "unique_id": "test.ctx_earned_hours_shadow.not_null_int_labor_detail_company_code.046945ad0d", "fqn": ["ctx_earned_hours_shadow", "i