 "emp_id"], "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "Kinetic employee master.", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "emp_id": {"name": "emp_id", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/staging/schema.yml", "build_path": "target/run/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__employee.sql", "unrendered_config": {"materialized": "incremental", "incremental_strategy": "merge", "schema": "BRONZE", "unique_key": ["company_code", "emp_id"]}, "created_at": 1792772564.9272747, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__employee", "raw_code": "{{\n    config(\n        unique_key=['company_code', 'emp_id']\n    )\n}}\n\n-- Bronze: Kinetic employee master. Thin rename only. Gated by the enrollment view (SD-10).\n-- jc_dept (JCDEPT) is the job-costing department -- the reporting one. The separate\n-- DEPARTMENT column is free-text HR data and is deliberately not carried as the\n-- reporting department (same column trap production documents).\n--\n-- SD-22: emp_id is normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(empid))      as emp_id,\n        name                    as full_name,\n        firstname               as first_name,\n        lastname                as last_name,\n        upper(trim(jcdept))     as jc_dept,\n        shift                   as shift_num,\n        laborrate               as labor_rate,\n        empstatus               as employee_status,\n        productionworker        as is_production_worker,\n        enrollmentdate          as enrollment_date_text,\n        departuredate           as departure_date_text,\n        sysrevid                as _sysrevid\n    from {{ source('ctxepicorkinetic', 'ERP_EMPBASIC') }}\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join {{ ref('stg_ctxepicorkinetic__company_enrollment') }} as gate\n    on source.company_code = gate.company_code", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__company_enrollment", "package": null, "version": null}], "sources": [["ctxepicorkinetic", "ERP_EMPBASIC"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctxepicorkinetic.ERP_EMPBASIC", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__employee.sql", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic employee master. Thin rename only. Gated by the enrollment view (SD-10).\n-- jc_dept (JCDEPT) is the job-costing department -- the reporting one. The separate\n-- DEPARTMENT column is free-text HR data and is deliberately not carried as the\n-- reporting department (same column trap production documents).\n--\n-- SD-22: emp_id is normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(empid))      as emp_id,\n        name                    as full_name,\n        firstname               as first_name,\n        lastname                as last_name,\n        upper(trim(jcdept))     as jc_dept,\n        shift                   as shift_num,\n        laborrate               as labor_rate,\n        empstatus               as employee_status,\n        productionworker        as is_production_worker,\n        enrollmentdate          as enrollment_date_text,\n        departuredate           as departure_date_text,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_EMPBASIC\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__department": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "BRONZE", "name": "stg_ctxepicorkinetic__department", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "staging/stg_ctxepicorkinetic__department.sql", "original_file_path": "models/staging/stg_ctxepicorkinetic__department.sql", "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__department", "fqn": ["ctx_earned_hours_shadow", "staging", "stg_ctxepicorkinetic__department"], "alias": "stg_ctxepicorkinetic__department", "checksum": {"name": "sha256", "checksum": "8b99199f6efe56b67b31d5b6f01bd7843a20c9285ed2e622a79268ca79f120a0"}, "config": {"enabled": true, "alias": null, "schema": "BRONZE", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "incremental", "incremental_strategy": "merge", "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": ["company_code", "jc_dept"], "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "Kinetic job-costing department master.", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "jc_dept": {"name": "jc_dept", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/staging/schema.yml", "build_path": "target/run/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__department.sql", "unrendered_config": {"materialized": "incremental", "incremental_strategy": "merge", "schema": "BRONZE", "unique_key": ["company_code", "jc_dept"]}, "created_at": 1792772564.9288292, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__department", "raw_code": "{{\n    config(\n        unique_key=['company_code', 'jc_dept']\n    )\n}}\n\n-- Bronze: Kinetic job-costing department master. Thin rename only.\n-- Gated by the enrollment view (SD-10).\n--\n-- SD-22: jc_dept is normalized with upper(trim()) defensively, for join consistency\n-- with the other models' jc_dept -- confirmed 0 case variance in this table itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jcdept))     as jc_dept,\n        description             as department_description,\n        globaljcdept            as is_global_jc_dept,\n        sysrevid                as _sysrevid\n    from {{ source('ctxepicorkinetic', 'ERP_JCDEPT') }}\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join {{ ref('stg_ctxepicorkinetic__company_enrollment') }} as gate\n    on source.company_code = gate.company_code", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__company_enrollment", "package": null, "version": null}], "sources": [["ctxepicorkinetic", "ERP_JCDEPT"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctxepicorkinetic.ERP_JCDEPT", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__department.sql", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job-costing department master. Thin rename only.\n-- Gated by the enrollment view (SD-10).\n--\n-- SD-22: jc_dept is normalized with upper(trim()) defensively, for join consistency\n-- with the other models' jc_dept -- confirmed 0 case variance in this table itself.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        upper(trim(jcdept))     as jc_dept,\n        description             as department_description,\n        globaljcdept            as is_global_jc_dept,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JCDEPT\n\n)\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_header": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "BRONZE", "name": "stg_ctxepicorkinetic__job_header", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "staging/stg_ctxepicorkinetic__job_header.sql", "original_file_path": "models/staging/stg_ctxepicorkinetic__job_header.sql", "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__job_header", "fqn": ["ctx_earned_hours_shadow", "staging", "stg_ctxepicorkinetic__job_header"], "alias": "stg_ctxepicorkinetic__job_header", "checksum": {"name": "sha256", "checksum": "d6de2080afbc29866612dcebfa220619586dcf34ca3abd4188d9a5341097a964"}, "config": {"enabled": true, "alias": null, "schema": "BRONZE", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "incremental", "incremental_strategy": "merge", "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": ["company_code", "job_num"], "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "Kinetic job header.", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "job_num": {"name": "job_num", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/staging/schema.yml", "build_path": "target/run/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__job_header.sql", "unrendered_config": {"materialized": "incremental", "incremental_strategy": "merge", "schema": "BRONZE", "unique_key": ["company_code", "job_num"]}, "created_at": 1792772564.9314427, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__job_header", "raw_code": "{{\n    config(\n        unique_key=['company_code', 'job_num']\n    )\n}}\n\n-- Bronze: Kinetic job header. Thin rename only. Gated by the enrollment view (SD-10).\n-- planned_start_quantity_not_produced -- renamed from PRODQTY (production's own trap:\n-- this is the PLANNED quantity, not what was actually produced; do not mistake it for\n-- quantity_produced on labor_detail/job_operation).\n--\n-- SD-22: job_num, part_num, part_revision are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding. part_num /\n-- part_revision case variance is also a contributing cause of the part-match-rate gap\n-- (SD-21).\n\nwith source as (\n\n    select\n        company                             as company_code,\n        upper(trim(jobnum))                 as job_num,\n        upper(trim(partnum))                as part_num,\n        upper(trim(revisionnum))            as part_revision,\n        partdescription                     as part_description,\n        prodqty                             as planned_start_quantity_not_produced,\n        jobtype                             as job_type,\n        jobengineered                       as is_job_engineered,\n        jobcomplete                         as is_job_complete,\n        jobclosed                           as is_job_closed,\n        startdate                           as start_date_text,\n        duedate                             as due_date_text,\n        plant                               as plant,\n        (upper(trim(jobnum)) like 'MRP-%')  as is_mrp_planning_job,\n        sysrevid                            as _sysrevid\n    from {{ source('ctxepicorkinetic', 'ERP_JOBHEAD') }}\n\n)\n\n-- is_mrp_planning_job: MRP-suggested planning jobs carry large estimated hours against\n-- zero produced quantity. They do not affect earned hours (which is driven by quantity\n-- produced), but would badly pollute any budget/estimate-side rollup if not flagged --\n-- a real source-data fact, not a stylistic choice (confirmed against the production\n-- build's own documented investigation of this pattern).\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join {{ ref('stg_ctxepicorkinetic__company_enrollment') }} as gate\n    on source.company_code = gate.company_code", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__company_enrollment", "package": null, "version": null}], "sources": [["ctxepicorkinetic", "ERP_JOBHEAD"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctxepicorkinetic.ERP_JOBHEAD", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__job_header.sql", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic job header. Thin rename only. Gated by the enrollment view (SD-10).\n-- planned_start_quantity_not_produced -- renamed from PRODQTY (production's own trap:\n-- this is the PLANNED quantity, not what was actually produced; do not mistake it for\n-- quantity_produced on labor_detail/job_operation).\n--\n-- SD-22: job_num, part_num, part_revision are normalized with upper(trim()) -- see\n-- stg_ctxepicorkinetic__labor_detail for the empirical case-variance finding. part_num /\n-- part_revision case variance is also a contributing cause of the part-match-rate gap\n-- (SD-21).\n\nwith source as (\n\n    select\n        company                             as company_code,\n        upper(trim(jobnum))                 as job_num,\n        upper(trim(partnum))                as part_num,\n        upper(trim(revisionnum))            as part_revision,\n        partdescription                     as part_description,\n        prodqty                             as planned_start_quantity_not_produced,\n        jobtype                             as job_type,\n        jobengineered                       as is_job_engineered,\n        jobcomplete                         as is_job_complete,\n        jobclosed                           as is_job_closed,\n        startdate                           as start_date_text,\n        duedate                             as due_date_text,\n        plant                               as plant,\n        (upper(trim(jobnum)) like 'MRP-%')  as is_mrp_planning_job,\n        sysrevid                            as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_JOBHEAD\n\n)\n\n-- is_mrp_planning_job: MRP-suggested planning jobs carry large estimated hours against\n-- zero produced quantity. They do not affect earned hours (which is driven by quantity\n-- produced), but would badly pollute any budget/estimate-side rollup if not flagged --\n-- a real source-data fact, not a stylistic choice (confirmed against the production\n-- build's own documented investigation of this pattern).\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__company_enrollment as gate\n    on source.company_code = gate.company_code", "extra_ctes_injected": true, "extra_ctes": [], "contract": {"enforced": false, "alias_types": true, "checksum": null}, "access": "protected", "constraints": [], "version": null, "latest_version": null, "deprecation_date": null, "primary_key": [], "time_spine": null}, "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__labor_detail": {"database": "SANDBOX_EARNEDHOURS_SHADOW", "schema": "BRONZE", "name": "stg_ctxepicorkinetic__labor_detail", "resource_type": "model", "package_name": "ctx_earned_hours_shadow", "path": "staging/stg_ctxepicorkinetic__labor_detail.sql", "original_file_path": "models/staging/stg_ctxepicorkinetic__labor_detail.sql", "unique_id": "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__labor_detail", "fqn": ["ctx_earned_hours_shadow", "staging", "stg_ctxepicorkinetic__labor_detail"], "alias": "stg_ctxepicorkinetic__labor_detail", "checksum": {"name": "sha256", "checksum": "7f93cae2fe37a31ada5f791646c12249aff25b62ab53567d42fc163c8cfdead8"}, "config": {"enabled": true, "alias": null, "schema": "BRONZE", "database": null, "tags": [], "meta": {}, "group": null, "materialized": "incremental", "incremental_strategy": "merge", "batch_size": null, "lookback": 1, "begin": null, "persist_docs": {}, "post-hook": [], "pre-hook": [], "quoting": {}, "column_types": {}, "full_refresh": null, "unique_key": ["company_code", "labor_header_seqnum", "labor_detail_seqnum"], "on_schema_change": "ignore", "on_configuration_change": "apply", "grants": {}, "packages": [], "docs": {"show": true, "node_color": null}, "contract": {"enforced": false, "alias_types": true}, "event_time": null, "concurrent_batches": null, "access": "protected"}, "tags": [], "description": "Kinetic labor detail -- the fact source. Grain = company + labor header + labor detail seqnum.", "columns": {"company_code": {"name": "company_code", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}, "job_num": {"name": "job_num", "description": "", "meta": {}, "data_type": null, "constraints": [], "quote": null, "tags": [], "granularity": null}}, "meta": {}, "group": null, "docs": {"show": true, "node_color": null}, "patch_path": "ctx_earned_hours_shadow://models/staging/schema.yml", "build_path": "target/run/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__labor_detail.sql", "unrendered_config": {"materialized": "incremental", "incremental_strategy": "merge", "schema": "BRONZE", "unique_key": ["company_code", "labor_header_seqnum", "labor_detail_seqnum"]}, "created_at": 1792772564.9322789, "relation_name": "SANDBOX_EARNEDHOURS_SHADOW.BRONZE.stg_ctxepicorkinetic__labor_detail", "raw_code": "{{\n    config(\n        unique_key=['company_code', 'labor_header_seqnum', 'labor_detail_seqnum']\n    )\n}}\n\n-- Bronze: Kinetic labor detail -- the Kinetic fact source.\n-- Thin rename only, no business logic. Gated by the enrollment view (SD-10), not a\n-- hardcoded company list. Carries Epicor's native EARNEDHRS through as a plain column --\n-- NOT treated as authoritative earned hours (SD-11). The real derivation happens in\n-- int_labor_standard_hours (Silver), from the operation's per-unit standard x quantity\n-- produced. This column exists here only so Silver can cross-check against it later.\n--\n-- SD-22: job_num, employee_num, resource_group_key, operation_code are normalized with\n-- upper(trim()) -- the same real-world key is stored with inconsistent casing across rows\n-- in the raw source (confirmed empirically, e.g. 'BPQ45915' vs 'bpq45915'). Case-sensitive\n-- joins on these columns silently drop matched rows. See PROJECT_LOG.md SD-22/SD-23.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        laborhedseq             as labor_header_seqnum,\n        labordtlseq             as labor_detail_seqnum,\n        upper(trim(employeenum)) as employee_num,\n        labortype               as labor_type_code,\n        labortypepseudo         as labor_type_pseudo,\n        rework                  as is_rework,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        upper(trim(jcdept))      as jc_dept,\n        upper(trim(resourcegrpid)) as resource_group_key,\n        laborhrs                as actual_hours,\n        burdenhrs               as burden_hours,\n        laborqty                as quantity_produced,\n        scrapqty                as quantity_scrapped,\n        earnedhrs               as native_earned_hours_crosscheck,\n        complete                as is_complete,\n        opcomplete              as is_operation_complete,\n        clockindate             as clock_in_date_text,\n        payrolldate             as payroll_date_text,\n        fiscalyear              as fiscal_year,\n        fiscalperiod            as fiscal_period,\n        postedtogl              as is_posted_to_gl,\n        wipposted               as is_wip_posted,\n        laborrate               as labor_rate,\n        burdenrate              as burden_rate,\n        sysrevid                as _sysrevid\n    from {{ source('ctxepicorkinetic', 'ERP_LABORDTL') }}\n\n)\n\n-- No is_incremental() filter: the source is a full flush-and-fill snapshot (SD-03), so\n-- every run re-presents the full filtered set and the merge's unique_key does the\n-- row-level insert/update. This does not handle source-side deletes -- acceptable for\n-- now, revisit if that becomes material.\n\nselect source.*, current_timestamp() as _loaded_at\nfrom source\ninner join {{ ref('stg_ctxepicorkinetic__company_enrollment') }} as gate\n    on source.company_code = gate.company_code", "language": "sql", "refs": [{"name": "stg_ctxepicorkinetic__company_enrollment", "package": null, "version": null}], "sources": [["ctxepicorkinetic", "ERP_LABORDTL"]], "metrics": [], "depends_on": {"macros": [], "nodes": ["source.ctx_earned_hours_shadow.ctxepicorkinetic.ERP_LABORDTL", "model.ctx_earned_hours_shadow.stg_ctxepicorkinetic__company_enrollment"]}, "compiled_path": "target/compiled/ctx_earned_hours_shadow/models/staging/stg_ctxepicorkinetic__labor_detail.sql", "compiled": true, "compiled_code": "\n\n-- Bronze: Kinetic labor detail -- the Kinetic fact source.\n-- Thin rename only, no business logic. Gated by the enrollment view (SD-10), not a\n-- hardcoded company list. Carries Epicor's native EARNEDHRS through as a plain column --\n-- NOT treated as authoritative earned hours (SD-11). The real derivation happens in\n-- int_labor_standard_hours (Silver), from the operation's per-unit standard x quantity\n-- produced. This column exists here only so Silver can cross-check against it later.\n--\n-- SD-22: job_num, employee_num, resource_group_key, operation_code are normalized with\n-- upper(trim()) -- the same real-world key is stored with inconsistent casing across rows\n-- in the raw source (confirmed empirically, e.g. 'BPQ45915' vs 'bpq45915'). Case-sensitive\n-- joins on these columns silently drop matched rows. See PROJECT_LOG.md SD-22/SD-23.\n\nwith source as (\n\n    select\n        company                 as company_code,\n        laborhedseq             as labor_header_seqnum,\n        labordtlseq             as labor_detail_seqnum,\n        upper(trim(employeenum)) as employee_num,\n        labortype               as labor_type_code,\n        labortypepseudo         as labor_type_pseudo,\n        rework                  as is_rework,\n        upper(trim(jobnum))     as job_num,\n        assemblyseq             as assembly_seqnum,\n        oprseq                  as operation_seqnum,\n        upper(trim(opcode))     as operation_code,\n        upper(trim(jcdept))      as jc_dept,\n        upper(trim(resourcegrpid)) as resource_group_key,\n        laborhrs                as actual_hours,\n        burdenhrs               as burden_hours,\n        laborqty                as quantity_produced,\n        scrapqty                as quantity_scrapped,\n        earnedhrs               as native_earned_hours_crosscheck,\n        complete                as is_complete,\n        opcomplete              as is_operation_complete,\n        clockindate             as clock_in_date_text,\n        payrolldate             as payroll_date_text,\n        fiscalyear              as fiscal_year,\n        fiscalperiod            as fiscal_period,\n        postedtogl              as is_posted_to_gl,\n        wipposted               as is_wip_posted,\n        laborrate               as labor_rate,\n        burdenrate              as burden_rate,\n        sysrevid                as _sysrevid\n    from MATILLION_RAW.CRETEX_EPICOR_KINETIC.ERP_LABORDTL\n\n)\n\n-- No is_incremental() filter: the source is a full flush-and-fill snapshot (SD-03), so\n-- every run re-presents the full filtered set and the merge's unique_key does the\n-- row-level insert/updat