", "execution_time": 1.4990971088409424, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7ee3f-0309-3938-0002-921610a41896"}, "message": null, "failures": 0, "unique_id": "test.ctx_earned_hours_shadow.not_null_dim_department_department_key.31a1ff542b", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect department_key\nfrom SANDBOX_EARNEDHOURS_SHADOW.GOLD.dim_department\nwhere department_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T21:51:07.095839Z", "completed_at": "2026-10-23T21:51:07.163238Z"}, {"name": "execute", "started_at": "2026-10-23T21:51:07.205518Z", "completed_at": "2026-10-23T21:51:08.926587Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.8614139556884766, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7ee3f-0309-3938-0002-921610a4188e"}, "message": null, "failures": 0, "unique_id": "test.ctx_earned_hours_shadow.assert_setup_credited_once_per_operation", "compiled": true, "compiled_code": "-- Singular test (SD-26): Setup's earned-hours credit is a FIXED, OPERATION-level amount\n-- that must be attributed exactly once per operation, regardless of how many Setup labor\n-- transactions exist on it (the historical defect this corrects for -- see\n-- int_labor_standard_hours header, job 200013 op 21: a 5-hour setup estimate was being\n-- accumulated across 13 labor entries before this was caught and fixed in the referenced\n-- business design process).\n--\n-- Asserts fct_labor.setup_earned_hours equals int_labor_standard_hours's own\n-- setup_earned_hours_credit exactly, for every operation that actually HAS at least one\n-- Setup labor transaction (operations with no Setup labor legitimately show NULL/0 in\n-- fct_labor regardless of what the raw operation-level credit would have been, which is\n-- correct, not a defect -- this test is scoped to only the operations where the credit\n-- should actually appear). If fct_labor's aggregation ever regresses from MAX() to SUM()\n-- (or an equivalent mistake), this test fails rather than silently re-introducing the\n-- double-counting defect.\n\nwith ops_with_setup_labor as (\n    select distinct company_code, job_num, assembly_seqnum, operation_seqnum\n    from SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail\n    where setup_earned_hours_credit is not null\n)\nselect\n    f.company_code, f.job_num, f.assembly_seqnum, f.operation_seqnum,\n    f.setup_earned_hours, s.setup_earned_hours_credit\nfrom ops_with_setup_labor o\njoin SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor as f\n    on  o.company_code     = f.company_code\n    and o.job_num          = f.job_num\n    and o.assembly_seqnum  = f.assembly_seqnum\n    and o.operation_seqnum = f.operation_seqnum\njoin SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_standard_hours as s\n    on  f.company_code     = s.company_code\n    and f.job_num           = s.job_num\n    and f.assembly_seqnum   = s.assembly_seqnum\n    and f.operation_seqnum  = s.operation_seqnum\nwhere abs(coalesce(f.setup_earned_hours, 0) - coalesce(s.setup_earned_hours_credit, 0)) > 0.01", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T21:51:08.529556Z", "completed_at": "2026-10-23T21:51:08.575246Z"}, {"name": "execute", "started_at": "2026-10-23T21:51:08.580379Z", "completed_at": "2026-10-23T21:51:09.096548Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.5741257667541504, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7ee3f-0309-3938-0002-921610a4191e"}, "message": null, "failures": 0, "unique_id": "test.ctx_earned_hours_shadow.not_null_fct_labor_labor_txns.24e9302a03", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect labor_txns\nfrom SANDBOX_EARNEDHOURS_SHADOW.GOLD.fct_labor\nwhere labor_txns is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "warn", "timing": [{"name": "compile", "started_at": "2026-10-23T21:51:08.549307Z", "completed_at": "2026-10-23T21:51:08.578700Z"}, {"name": "execute", "started_at": "2026-10-23T21:51:08.601203Z", "completed_at": "2026-10-23T21:51:09.210215Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.6848015785217285, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7ee3f-0309-3938-0002-921610a41936"}, "message": "Got 242 results, configured to warn if != 0", "failures": 242, "unique_id": "test.ctx_earned_hours_shadow.not_null_int_labor_detail_earned_hours.bb46ca7b6e", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect earned_hours\nfrom SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail\nwhere earned_hours is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T21:51:08.541547Z", "completed_at": "2026-10-23T21:51:08.577004Z"}, {"name": "execute", "started_at": "2026-10-23T21:51:08.594755Z", "completed_at": "2026-10-23T21:51:09.229333Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.7046887874603271, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c7ee3f-0309-3938-0002-921610a41932"}, "message": null, "failures": 0, "unique_id": "test.ctx_earned_hours_shadow.not_null_int_labor_detail_company_code.046945ad0d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect company_code\nfrom SANDBOX_EARNEDHOURS_SHADOW.SILVER.int_labor_detail\nwhere company_code is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-23T21:51:08.586659Z", "completed_at": "2026-10-23T21:51:08.618728Z"}, {"name": "execute", "started_at": "2026-10-23T21:51:08.626407Z", "completed_at": "2026-10-23T21:51:09.232383Z"}], "thread_id":